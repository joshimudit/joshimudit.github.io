---
// Drawn graphics for studies without published figures. Each one shows what the study is about,
// never its results. Coloured by theme variables, so they follow day and night.
import { geoEquirectangular, geoPath, geoContains } from 'd3-geo';
import { feature } from 'topojson-client';
import land110 from 'world-atlas/land-110m.json';

interface Props { kind: 'niches' | 'productivity' | 'context' | 'strata' }
const { kind } = Astro.props;
const W = 400, H = 240;
const f = (n: number) => n.toFixed(1);

// niches: Africa and the Mediterranean as a grid of cells, with a time axis beside it
const cells: { x: number; y: number; t: number }[] = [];
let landD = '', cs = 0;
if (kind === 'niches') {
  const landF = feature(land110 as any, (land110 as any).objects.land) as any;
  const box = { type: 'Feature', geometry: { type: 'MultiPoint', coordinates: [[-19, 44], [53, 44], [-19, -36], [53, -36]] } } as any;
  const proj = geoEquirectangular().fitExtent([[16, 14], [216, 226]], box);
  landD = geoPath(proj)(landF) ?? '';
  const step = 3.2, a = proj([0, 0])!, b = proj([step, 0])!;
  cs = (b[0] - a[0]) * 0.8;
  // a smooth, made-up field: a few bands read as 'suitable'. Illustration only, not a result.
  for (let lat = 42; lat >= -35; lat -= step) {
    for (let lon = -17; lon <= 52; lon += step) {
      if (!geoContains(landF, [lon, lat])) continue;
      const pt = proj([lon, lat]); if (!pt) continue;
      const t = Math.max(Math.exp(-(((lat - 36) / 4.5) ** 2)), Math.exp(-(((lat - 12) / 4) ** 2)), 0.9 * Math.exp(-(((lat + 24) / 5) ** 2)), Math.exp(-(((lon - 37) / 4) ** 2) - ((lat - 2) / 10) ** 2));
      cells.push({ x: pt[0], y: pt[1], t });
    }
  }
}

---
<svg class={`art ${kind}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
  <rect width={W} height={H} class="bg" />

  {kind === 'niches' && (
    <g>
      <defs><clipPath id="nclip"><rect x="16" y="14" width="200" height="212" /></clipPath></defs>
      <path d={landD} class="land" clip-path="url(#nclip)" />
      {cells.map((c) => <rect x={f(c.x - cs / 2)} y={f(c.y - cs / 2)} width={f(cs)} height={f(cs)} rx="1" class={c.t > 0.55 ? 'cell hi' : c.t > 0.25 ? 'cell part' : 'cell'} />)}
      <g transform="translate(262 40)">
        <path d="M14 96V8" class="stem" />
        {[0, 1, 2, 3, 4, 5].map((i) => <ellipse cx={i % 2 ? 19 : 9} cy={14 + i * 9} rx="5.2" ry="3.2" transform={`rotate(${i % 2 ? 28 : -28} ${i % 2 ? 19 : 9} ${14 + i * 9})`} class="grain" />)}
        <path d="M58 96V20" class="stem" />
        <ellipse cx="58" cy="30" rx="9" ry="16" class="grain dense" />
        <path d="M102 96V14" class="stem" />
        <rect x="97" y="14" width="10" height="44" rx="5" class="grain" />
      </g>
      <g transform="translate(250 164)">
        <rect x="0" y="-9" width="10" height="10" rx="1.5" class="cell hi" /><text x="16" y="0" class="lbl">suitable climate</text>
      </g>
      <g transform="translate(244 200)">
        <path d="M0 0H144M0 -4V4M48 -3V3M96 -3V3M144 -4V4" class="ax" />
        <text x="0" y="20" class="lbl">12,000 years ago</text>
        <text x="144" y="20" class="lbl" text-anchor="end">today</text>
      </g>
    </g>
  )}

  {kind === 'productivity' && (
    <g>
      <g class="gridln">{[0, 1, 2, 3, 4, 5, 6].map((i) => <path d={`M${f(40 + i * 53.3)} 40V196`} />)}</g>
      <path d="M20 170H380" class="ground" />
      <rect x="20" y="170" width="360" height="26" class="soil1" />
      <rect x="20" y="196" width="360" height="26" class="soil2" />
      {[[62, 1], [92, 0.8], [128, 1.1], [160, 0.75]].map(([x, s]) => (
        <g transform={`translate(${x} 170) scale(${s})`}>
          <path d="M0 0V-34" class="trunk" />
          <circle cx="0" cy="-48" r="17" class="crown" />
        </g>
      ))}
      {[48, 76, 110, 144, 176].map((x) => <path d={`M${x} 170l-3 -9M${x} 170l0 -11M${x} 170l3 -9`} class="grass" />)}
      {Array.from({ length: 9 }, (_, i) => (
        <g transform={`translate(${222 + i * 17} 170)`}>
          <path d="M0 0V-30" class="crop" />
          <ellipse cx="0" cy="-34" rx="3.2" ry="6" class="head" />
          <path d="M0 -12l-6 -6M0 -18l6 -6" class="crop" />
        </g>
      ))}
      <circle cx="350" cy="36" r="13" class="sun" />
      <path d="M332 48L296 92" class="flow light" marker-end="url(#ah)" />
      <path d="M116 62V94" class="flow co2" marker-end="url(#ah)" />
      <text x="122" y="58" class="lbl">CO₂</text>
      <path d="M70 178V202" class="flow water" marker-end="url(#ah)" />
      <path d="M250 196V178" class="flow water" marker-end="url(#ah)" />
      <text x="40" y="34" class="lbl">natural vegetation</text>
      <text x="222" y="34" class="lbl">cropland</text>
      <defs><marker id="ah" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0L8 4L0 8Z" class="tip" /></marker></defs>
    </g>
  )}

  {kind === 'context' && (
    <g>
      <text x="24" y="36" class="lbl">dated crop records</text>
      <path d="M24 92H120" class="ax" />
      {[30, 44, 52, 63, 71, 78, 86, 95, 101, 108, 114].map((x, i) => <circle cx={x} cy={92 - 8 - (i % 3) * 9} r="3.6" class={i % 4 === 0 ? 'rec alt' : 'rec'} />)}
      <text x="24" y="110" class="lbl">past</text>
      <path d="M128 92H148" class="link" marker-end="url(#ah3)" />

      <text x="156" y="36" class="lbl">crops grown today</text>
      {[[0, 34, 'a'], [34, 22, 'b'], [56, 18, 'c'], [74, 14, 'd']].map(([x0, w, c]) => <rect x={156 + (x0 as number)} y="70" width={w} height="22" class={`share ${c}`} />)}
      <text x="156" y="110" class="lbl">present</text>
      <path d="M252 82C268 82 270 60 284 58" class="link dash" marker-end="url(#ah3)" />
      <path d="M252 82C268 82 270 104 284 106" class="link dash" marker-end="url(#ah3)" />

      <text x="292" y="36" class="lbl">climate and policy</text>
      {[[0, 40, 'a'], [40, 22, 'b'], [62, 14, 'c'], [76, 12, 'd']].map(([x0, w, c]) => <rect x={292 + (x0 as number)} y="48" width={w} height="16" class={`share ${c}`} />)}
      {[[0, 14, 'a'], [14, 14, 'b'], [28, 26, 'c'], [54, 34, 'd']].map(([x0, w, c]) => <rect x={292 + (x0 as number)} y="98" width={w} height="16" class={`share ${c}`} />)}
      <text x="292" y="132" class="lbl">possible futures</text>

      {[0, 1, 2, 3, 4, 5].map((i) => <path d={`M${60 + i * 56} 220v-40M${60 + i * 56} 196l-7 -8M${60 + i * 56} 188l7 -8M${60 + i * 56} 204l-7 -7`} class="sprout" />)}
      <path d="M20 220H380" class="ax" />
      <defs><marker id="ah3" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0L8 4L0 8Z" class="tip" /></marker></defs>
    </g>
  )}

  {kind === 'strata' && (
    <g>
      {[0, 1, 2, 3].map((l) => <path d={`M0 ${236 - l * 40}L0 ${200 - l * 40}Q100 ${192 - l * 40} 200 ${200 - l * 40}T400 ${198 - l * 40}L400 ${236 - l * 40}Z`} class={`layer l${l}`} />)}
      <g transform="translate(58 214)" class="icon"><path d="M-22 6h44M-14 6v-8h28v8M-8 -2v-7h16v7" /></g>
      <g transform="translate(300 176)" class="icon"><path d="M-10 8c-2-8 0-14 10-14s12 6 10 14ZM-6 -6v-4h12v4" /></g>
      <g transform="translate(110 134)" class="icon"><path d="M-14 4h22c4 0 6-3 6-6s-3-5-6-5h-16c-4 0-6 3-6 6ZM-10 4v6M4 4v6M14 -5l4 -4" /></g>
      <g transform="translate(250 96)" class="icon"><path d="M-16 0c8-6 8 6 16 0s8 6 16 0M-16 8c8-6 8 6 16 0s8 6 16 0" /></g>
      <path d="M58 200C120 170 260 190 300 160S160 120 250 84" class="thread" />
      <path d="M250 84C300 60 330 44 360 26" class="thread future" marker-end="url(#ah2)" />
      <text x="296" y="40" class="lbl" text-anchor="end">after 2030</text>
      <text x="12" y="18" class="lbl">evidence from the past</text>
      <defs><marker id="ah2" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0L8 4L0 8Z" class="tip" /></marker></defs>
    </g>
  )}
</svg>

<style>
  .art { display: block; width: 100%; height: 100%; }
  .bg { fill: var(--surface); }
  .lbl { font: 500 11.5px var(--sans); fill: var(--muted); }
  .ax { stroke: var(--muted); stroke-width: 1.2; fill: none; }
  .tip { fill: var(--muted); }

  .land { fill: none; stroke: var(--line); stroke-width: 1; }
  .cell { fill: var(--line); }
  .cell.part { fill: var(--ochre-soft); }
  .cell.hi { fill: var(--ochre-fill); }
  .stem { stroke: var(--muted); stroke-width: 1.6; fill: none; }
  .grain { fill: var(--ochre-fill); }
  .grain.dense { fill: var(--ochre); }

  .gridln path { stroke: var(--line); stroke-width: 1; stroke-dasharray: 2 4; }
  .ground { stroke: var(--muted); stroke-width: 1.2; }
  .soil1 { fill: var(--ochre-soft); } .soil2 { fill: color-mix(in srgb, var(--ochre-soft) 60%, var(--line)); }
  .trunk { stroke: var(--muted); stroke-width: 3; }
  .crown { fill: var(--blue); opacity: 0.85; }
  .grass { stroke: var(--blue); stroke-width: 1.6; fill: none; stroke-linecap: round; }
  .crop { stroke: var(--moss); stroke-width: 1.6; fill: none; stroke-linecap: round; }
  .head { fill: var(--ochre-fill); }
  .sun { fill: var(--ochre-fill); }
  .flow { fill: none; stroke-width: 1.6; stroke: var(--muted); stroke-dasharray: 4 3; }
  .flow.water { stroke: var(--blue); }

  .rec { fill: var(--ochre-fill); } .rec.alt { fill: var(--blue); }
  .link { fill: none; stroke: var(--muted); stroke-width: 1.4; } .link.dash { stroke-dasharray: 4 3; }
  .share { stroke: var(--surface); stroke-width: 1.5; }
  .share.a { fill: var(--ochre-fill); } .share.b { fill: var(--ochre-soft); } .share.c { fill: var(--blue); } .share.d { fill: var(--blue-soft); }
  .sprout { stroke: var(--moss); stroke-width: 1.6; fill: none; stroke-linecap: round; }

  .layer { stroke: var(--surface); stroke-width: 2; }
  .l0 { fill: color-mix(in srgb, var(--ochre-soft) 70%, var(--line)); } .l1 { fill: var(--ochre-soft); }
  .l2 { fill: color-mix(in srgb, var(--blue-soft) 60%, var(--line)); } .l3 { fill: var(--blue-soft); }
  .icon path { fill: none; stroke: var(--ink); stroke-width: 1.6; stroke-linejoin: round; stroke-linecap: round; opacity: 0.75; }
  .thread { fill: none; stroke: var(--ochre); stroke-width: 2.2; }
  .thread.future { stroke-dasharray: 5 5; }
</style>
