---
import { profile, web3formsKey } from '../data/profile';
---
{web3formsKey ? (
  <form class="contact" action="https://api.web3forms.com/submit" method="POST" data-contact>
    <input type="hidden" name="access_key" value={web3formsKey} />
    <input type="hidden" name="subject" value="New message from your website" />
    <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />
    <label>Your name<input name="name" required autocomplete="name" /></label>
    <label>Your email, if you’d like a reply<input name="email" type="email" autocomplete="email" placeholder="name@example.org" /></label>
    <label>Message<textarea name="message" rows="6" required></textarea></label>
    <button type="submit">Send message</button>
    <p class="status" role="status" aria-live="polite"></p>
  </form>
) : (
  <div class="contact">
    <p>The message form opens soon. Until then, email me at <a href={`mailto:${profile.email}`}>{profile.email}</a>.</p>
  </div>
)}

<script>
  const form = document.querySelector('[data-contact]') as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector('.status') as HTMLElement;
    const button = form.querySelector('button') as HTMLButtonElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = await res.json();
        if (data.success) { form.reset(); status.textContent = 'Message sent. Thank you.'; }
        else status.textContent = 'That didn’t go through. Check the fields and try again.';
      } catch {
        status.textContent = 'No connection. Try again in a moment.';
      }
      button.disabled = false;
    });
  }
</script>

<style>
  .contact { display: grid; gap: 1rem; max-width: 38rem; }
  label { display: grid; gap: 0.35rem; font-size: 0.95rem; }
  input, textarea { font: inherit; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 4px; padding: 0.65rem 0.8rem; }
  input:focus, textarea:focus { border-color: var(--blue); outline: none; box-shadow: 0 0 0 2px color-mix(in srgb, var(--blue) 30%, transparent); }
  button { justify-self: start; font: inherit; background: var(--blue); color: var(--on-accent); border: 0; border-radius: 3px; padding: 0.6rem 1.2rem; font-weight: 500; cursor: pointer; }
  button:disabled { opacity: 0.6; }
  .status { margin: 0; color: var(--muted); min-height: 1.5em; }
</style>
