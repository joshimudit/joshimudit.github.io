---
// The signature element: Mudit's work on one log-scaled time axis,
// from 400 million years ago (the start of his thesis) to after 2030.
import { projects } from '../data/projects';

const L = Math.log10(4e8); // 400 million years ago = left edge
const X = (yearsAgo: number) => ((L - Math.log10(yearsAgo)) / L) * 85;

const eras = [
  { id: 'deep', name: 'Deep time', span: 'From 400 million years ago', x: 0.6 },
  { id: 'holocene', name: 'The Holocene', span: 'The last 10,000 years', x: X(1e4) },
  { id: 'now', name: 'Today', span: 'Farming now', x: 85 },
  { id: 'next', name: 'What comes next', span: 'After 2030', x: 94 },
];
// Extra links per era (e.g. the Studio once it has a first case study).
const extra: Record<string, { label: string; href: string }[]> = {};
const ticks = [1e8, 1e7, 1e6, 1e5, 1e4, 1e3, 1e2, 1e1].map(X);
---
<div class="ruler">
  <div class="track" aria-hidden="true">
    <svg viewBox="0 0 100 14" preserveAspectRatio="none" class="axis">
      <rect x={X(1e4)} y="5" width={85 - X(1e4)} height="4" class="holo" />
      <line x1="0" y1="7" x2="85" y2="7" class="line" />
      <line x1="85" y1="7" x2="100" y2="7" class="line future" />
      {ticks.map((t) => <line x1={t} x2={t} y1="4.5" y2="9.5" class="tick" />)}
    </svg>
    <div class="dots">
      {eras.map((e) => <span class={`dot dot-${e.id}`} style={`left:${e.x}%`}></span>)}
    </div>
  </div>
  <div class="scale data" aria-hidden="true">
    <span style="left:0">400 million years ago</span>
    <span style={`left:${X(1e4)}%`}>10,000</span>
    <span style="left:85%">Now</span>
    <span style="left:94%">2030+</span>
  </div>

  <ol class="eras">
    {eras.map((e) => (
      <li class={`era era-${e.id}`}>
        <h3><span class={`swatch sw-${e.id}`} aria-hidden="true"></span>{e.name}</h3>
        <p class="span">{e.span}</p>
        <ul>
          {projects.filter((p) => p.era === e.id).map((p) => (
            <li><a href={`/work#${p.slug}`}>{p.title}</a></li>
          ))}
          {(extra[e.id] || []).map((x) => <li><a href={x.href}>{x.label}</a></li>)}
        </ul>
      </li>
    ))}
  </ol>
</div>

<style>
  .ruler { margin-top: 2rem; }
  .track { position: relative; }
  .axis { width: 100%; height: 3.25rem; display: block; }
  .line { stroke: var(--ink); stroke-width: 1.5px; vector-effect: non-scaling-stroke; }
  .future { stroke-dasharray: 4 4; }
  .tick { stroke: var(--muted); stroke-width: 1px; vector-effect: non-scaling-stroke; }
  .holo { fill: var(--ochre-soft); }
  .dots { position: absolute; inset: 0; }
  .dot { position: absolute; top: 50%; width: 0.8rem; height: 0.8rem; border-radius: 50%; transform: translate(-50%, -50%); background: var(--bg); border: 2px solid var(--ink); }
  .dot-holocene, .dot-now { background: var(--ochre-fill); border-color: var(--ochre-fill); }
  .dot-next { background: var(--blue); border-color: var(--blue); }

  .scale { position: relative; height: 1.4rem; }
  .scale span { position: absolute; top: 0; transform: translateX(-50%); white-space: nowrap; }
  .scale span:first-child { transform: none; }

  .eras { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; grid-template-columns: 0.75fr 1.2fr 1.2fr 1.2fr; }
  .era { padding: 0.25rem 1.5rem 0.5rem; border-left: 1px solid var(--line); }
  .era:first-child { padding-left: 0; border-left: 0; }
  .era h3 { display: flex; align-items: center; gap: 0.55rem; margin-bottom: 0.1rem; font-size: 1.2rem; }
  .swatch { width: 0.7rem; height: 0.7rem; border-radius: 50%; flex: none; border: 2px solid var(--ink); }
  .sw-holocene, .sw-now { background: var(--ochre-fill); border-color: var(--ochre-fill); }
  .sw-next { background: var(--blue); border-color: var(--blue); }
  .span { color: var(--muted); font-size: 0.88rem; margin-bottom: 0.9rem; padding-left: 1.25rem; }
  .era ul { list-style: none; padding: 0 0 0 1.25rem; margin: 0; display: grid; gap: 0.1rem; }
  .era li { padding: 0.4rem 0; border-bottom: 1px dotted var(--line); }
  .era li:last-child { border-bottom: 0; }
  .era a { color: var(--ink); text-decoration: none; }
  .era a:hover { color: var(--blue); text-decoration: underline; }

  @media (max-width: 860px) {
    .track, .scale { display: none; }
    .eras { grid-template-columns: 1fr; gap: 1.25rem; }
    .era { padding-left: 0; border-left: 0; }
  }
</style>
