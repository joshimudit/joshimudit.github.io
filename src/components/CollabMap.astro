---
// Map of current and past collaborations, drawn at build time (no runtime JS).
import { geoNaturalEarth1, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import land110 from 'world-atlas/land-110m.json';
import { collaborations } from '../data/profile';

const W = 960, H = 620;
const extent = {
  type: 'Feature',
  geometry: { type: 'MultiPoint', coordinates: [[-14, 62], [88, 62], [-14, -36], [88, -36]] },
};
const projection = geoNaturalEarth1().fitExtent([[10, 10], [W - 10, H - 10]], extent as any);
const path = geoPath(projection);
const land = path(feature(land110 as any, (land110 as any).objects.land) as any);
const graticule = Array.from({ length: 9 }, (_, i) => -30 + i * 15).map((lat) =>
  path({ type: 'LineString', coordinates: Array.from({ length: 61 }, (_, j) => [-40 + j * 2.2, lat]) } as any),
);
const pins = collaborations.map((c) => {
  const [x, y] = projection([c.lon, c.lat])!;
  return { ...c, x, y };
});
const agridry = collaborations.filter((c) => c.group === 'agridry');
const past = collaborations.filter((c) => c.group === 'past');
---
<div class="collab">
  <figure class="map">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="map-title">
      <title id="map-title">Map of current and past collaborations across Europe, Africa and India</title>
      {graticule.map((g) => <path d={g} class="grat" />)}
      <path d={land} class="land" />
      {pins.map((p) => (
        <a href={p.href} aria-label={`${p.name}, ${p.place}`}>
          <circle cx={p.x} cy={p.y} r="7" class={`pin ${p.group}`} />
          <title>{p.name}, {p.place}</title>
        </a>
      ))}
    </svg>
    <figcaption>
      <span class="key"><span class="k agridry"></span>AGRI-DRY network</span>
      <span class="key"><span class="k past"></span>Earlier studies and work</span>
    </figcaption>
  </figure>

  <div class="lists">
    <div>
      <h3>AGRI-DRY network</h3>
      <ul>
        {agridry.map((c) => (
          <li><a href={c.href}><span class="mark agridry">{c.short}</span><span class="n">{c.name}<small>{c.role}, {c.country}</small></span></a></li>
        ))}
      </ul>
    </div>
    <div>
      <h3>Earlier studies and work</h3>
      <ul>
        {past.map((c) => (
          <li><a href={c.href}><span class="mark past">{c.short}</span><span class="n">{c.name}<small>{c.role}, {c.country}</small></span></a></li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style>
  .collab { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2rem 3rem; align-items: start; }
  .map { margin: 0; }
  .map svg { width: 100%; height: auto; display: block; }
  .land { fill: var(--blue-soft); stroke: var(--line); stroke-width: 0.8; }
  .grat { fill: none; stroke: var(--line); stroke-width: 0.6; stroke-dasharray: 2 4; }
  .pin { stroke: var(--bg); stroke-width: 2.5; transition: r 0.15s ease; }
  .pin.agridry { fill: var(--blue); }
  .pin.past { fill: var(--ochre-fill); }
  a:hover .pin, a:focus .pin { r: 10; }
  figcaption { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 0.75rem; font-size: 0.88rem; color: var(--muted); }
  .key { display: inline-flex; align-items: center; gap: 0.45rem; }
  .k { width: 0.7rem; height: 0.7rem; border-radius: 50%; }
  .k.agridry { background: var(--blue); }
  .k.past { background: var(--ochre-fill); }

  .lists { display: grid; gap: 1.75rem; }
  .lists h3 { font-family: var(--sans); font-weight: 500; font-size: 1rem; margin-bottom: 0.75rem; color: var(--muted); }
  .lists ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .lists a { display: grid; grid-template-columns: 5.5rem 1fr; gap: 0.85rem; align-items: center; text-decoration: none; color: var(--ink); padding: 0.35rem; border-radius: 4px; }
  .lists a:hover { background: var(--surface); }
  .mark { display: grid; place-items: center; height: 2.6rem; border-radius: 3px; font-family: var(--serif); font-size: 0.95rem; }
  .mark.agridry { background: var(--blue-soft); color: var(--blue); }
  .mark.past { background: var(--ochre-soft); color: var(--ochre); }
  .n { display: grid; font-size: 0.95rem; line-height: 1.3; }
  .n small { color: var(--muted); font-size: 0.82rem; }
  @media (max-width: 860px) { .collab { grid-template-columns: 1fr; } }
</style>
