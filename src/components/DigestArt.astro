---
// Generated cover for digest items whose source has no preview image.
// Draws soft "contour lines" seeded from the item title, so every story gets
// its own quiet, map-like graphic in the site palette. Built at compile time, no JS.
interface Props { seed: string; label?: string }
const { seed, label } = Astro.props;

// Small deterministic PRNG (mulberry32) seeded from a string hash.
let h = 1779033703 ^ seed.length;
for (let i = 0; i < seed.length; i++) {
  h = Math.imul(h ^ seed.charCodeAt(i), 3432918353);
  h = (h << 13) | (h >>> 19);
}
let a = h >>> 0;
const rand = () => {
  a |= 0; a = (a + 0x6d2b79f5) | 0;
  let t = Math.imul(a ^ (a >>> 15), 1 | a);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

const W = 600, H = 400;
const cx = W * (0.3 + rand() * 0.4);
const cy = H * (0.3 + rand() * 0.4);
const phases = Array.from({ length: 4 }, () => rand() * Math.PI * 2);
const amps = [0.16, 0.09, 0.05, 0.03].map((m) => m * (0.6 + rand() * 0.8));
const freqs = [2, 3, 5, 7];
const rings = 13;
const accent = Math.floor(rand() * 4) + 4; // one ring drawn in the warm accent

function ring(r: number, k: number) {
  const pts: string[] = [];
  const steps = 96;
  for (let s = 0; s <= steps; s++) {
    const th = (s / steps) * Math.PI * 2;
    let m = 1;
    for (let j = 0; j < 4; j++) m += amps[j] * Math.sin(freqs[j] * th + phases[j] + k * 0.35);
    const rr = r * m;
    pts.push(`${(cx + rr * Math.cos(th) * 1.35).toFixed(1)},${(cy + rr * Math.sin(th)).toFixed(1)}`);
  }
  return 'M' + pts.join('L') + 'Z';
}
const paths = Array.from({ length: rings }, (_, k) => ({ d: ring(18 + k * 26, k), accent: k === accent }));
const dot = { x: cx + (rand() - 0.5) * 40, y: cy + (rand() - 0.5) * 30 };
---
<svg class="art" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" role="presentation" aria-hidden="true">
  <rect width={W} height={H} class="art-bg" />
  {paths.map((p) => <path d={p.d} class:list={['art-line', { 'art-accent': p.accent }]} />)}
  <circle cx={dot.x} cy={dot.y} r="4" class="art-dot" />
  {label && <text x="20" y={H - 20} class="art-label">{label}</text>}
</svg>

<style>
  .art { width: 100%; height: 100%; display: block; }
  .art-bg { fill: color-mix(in srgb, var(--blue) 7%, var(--bg)); }
  .art-line { fill: none; stroke: color-mix(in srgb, var(--blue) 38%, transparent); stroke-width: 1.1; }
  .art-accent { stroke: var(--ochre); stroke-width: 1.6; }
  .art-dot { fill: var(--ochre); }
  .art-label { font-family: var(--mono); font-size: 15px; fill: var(--muted); letter-spacing: 0.04em; }
</style>
