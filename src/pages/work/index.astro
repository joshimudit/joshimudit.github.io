---
import Base from '../../layouts/Base.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import { projects } from '../../data/projects';
const groups = [
  { label: 'Ongoing', list: projects.filter((p) => p.status === 'ongoing') },
  { label: 'Completed', list: projects.filter((p) => p.status === 'completed') },
];
---
<Base title="Work" description="Research by Mudit Joshi: crops, vegetation and climate over the last 12,000 years, adaptation beyond 2030, and plant biodiversity over 400 million years.">
  <div class="wrap page">
    <header class="page-head">
      <h1>Work</h1>
      <p>Ongoing and completed research projects that I lead or contribute to. Open any project for its aims, methods and collaborators.</p>
    </header>

    {groups.filter((g) => g.list.length).map((g) => (
      <section class="group" aria-labelledby={`g-${g.label}`}>
        <h2 id={`g-${g.label}`}>{g.label}</h2>
        <div class="cards">
          {g.list.map((p) => (
            <a class="card" id={p.slug} href={`/work/${p.slug}`}>
              <div class="pic">
                {'src' in p.art ? <img src={p.art.src} alt="" loading="lazy" /> : <ProjectArt kind={p.art.kind} />}
              </div>
              <div class="txt">
                <p class="meta"><span class={`role-tag ${p.role === 'Lead author' ? 'lead' : 'co'}`}>{p.role}</span>{p.lead && <span>Lead author: {p.lead.name}</span>}<span>{p.output}</span></p>
                <h3>{p.title}</h3>
                <p class="sum">{p.summary}</p>
                <ul class="methods" aria-label="Methods">{p.methods.slice(0, 3).map((m) => <li>{m}</li>)}</ul>
                <span class="more">Read more</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  .group { margin-bottom: 3.5rem; }
  .group > h2 { font-size: 1.5rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--line); margin-bottom: 1.5rem; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); gap: 1.5rem; }
  .card { display: grid; grid-template-rows: auto 1fr; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; overflow: hidden; scroll-margin-top: 5rem; color: var(--ink); text-decoration: none; transition: border-color 0.15s; }
  .card:hover, .card:focus-visible { border-color: var(--muted); }
  .card:hover h3, .card:focus-visible h3 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
  .pic { aspect-ratio: 5 / 3; border-bottom: 1px solid var(--line); background: var(--surface); }
  .pic img { width: 100%; height: 100%; object-fit: cover; display: block; background: #fff; }
  .txt { padding: 1.1rem 1.3rem 1.3rem; display: grid; grid-template-rows: auto auto 1fr auto auto; gap: 0.55rem; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.4rem 0.8rem; align-items: center; margin: 0; font-size: 0.85rem; color: var(--muted); }
  .card h3 { margin: 0.1rem 0 0; font-size: 1.3rem; }
  .sum { margin: 0; font-size: 0.97rem; }
  .methods { list-style: none; padding: 0; margin: 0.2rem 0 0; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .methods li { font-size: 0.78rem; padding: 0.1rem 0.55rem; border-radius: 3px; background: var(--bg); color: var(--muted); }
  .role-tag { font-size: 0.78rem; padding: 0.05rem 0.5rem; border-radius: 3px; }
  .role-tag.lead { background: var(--ochre-soft); color: var(--ochre); }
  .role-tag.co { background: var(--blue-soft); color: var(--blue); }
  .more { font-size: 0.9rem; color: var(--blue); margin-top: 0.2rem; }
</style>
