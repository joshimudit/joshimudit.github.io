---
import Base from '../../layouts/Base.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Project };
const i = projects.indexOf(p), next = projects[(i + 1) % projects.length];
---
<Base title={p.title} description={p.summary}>
  <article class="wrap page study">
    <nav class="crumb" aria-label="Where you are"><a href="/work">Work</a><span aria-hidden="true">/</span><span>{p.status === 'ongoing' ? 'Ongoing' : 'Completed'}</span></nav>

    <header class="head">
      <div>
        <h1>{p.title}</h1>
        <p class="lede">{p.summary}</p>
        <dl class="facts">
          <div><dt>Role</dt><dd>{p.role}</dd></div>
          {p.lead && <div><dt>Lead author</dt><dd>{p.lead.href ? <a href={p.lead.href}>{p.lead.name}</a> : p.lead.name}</dd></div>}
          <div><dt>Status</dt><dd>{p.outputLink ? <a href={p.outputLink}>{p.output}</a> : p.output}</dd></div>
          <div><dt>Part of</dt><dd>{p.period}</dd></div>
          <div><dt>Where</dt><dd>{p.where}</dd></div>
        </dl>
      </div>
      <figure class="art">
        {'src' in p.art ? <img src={p.art.src} alt={p.art.alt} /> : <ProjectArt kind={p.art.kind} />}
      </figure>
    </header>

    <div class="body">
      <section>
        <h2>{p.results ? 'Questions' : 'Aims'}</h2>
        <ul>{p.aims.map((a) => <li>{a}</li>)}</ul>
      </section>

      <section>
        <h2>Approach</h2>
        {p.approach.map((a) => <p set:html={a} />)}
        <ul class="methods" aria-label="Methods and tools">{p.methods.map((m) => <li>{m}</li>)}</ul>
        {p.figures?.filter((f) => f.in === 'approach').map((f) => <figure class="fig" style={`max-width:${f.height > f.width * 0.9 ? 30 : 46}rem`}><img src={f.src} alt={f.alt} width={f.width} height={f.height} loading="lazy" /><figcaption>{f.caption}</figcaption></figure>)}
      </section>

      {p.results ? (
        <section>
          <h2>What I found</h2>
          <ul>{p.results.map((r) => <li>{r}</li>)}</ul>
          {p.figures?.filter((f) => f.in === 'results').map((f) => <figure class="fig" style={`max-width:${f.height > f.width * 0.9 ? 30 : 46}rem`}><img src={f.src} alt={f.alt} width={f.width} height={f.height} loading="lazy" /><figcaption>{f.caption}</figcaption></figure>)}
        </section>
      ) : (
        <section>
          <h2>Results</h2>
          <p class="quiet">{p.output === 'Under review' ? 'The paper is under peer review. Results will appear here once it is published.' : 'This study is in progress. Results will appear here once the paper is published.'}</p>
        </section>
      )}

      {p.team && (
        <section>
          <h2>Other team members</h2>
          <ul class="team">
            {p.team.map((t) => <li>{t.href ? <a href={t.href}>{t.name}</a> : t.name}{t.role && <span> ({t.role})</span>}</li>)}
          </ul>
        </section>
      )}

      {p.links && (
        <section>
          <h2>Links</h2>
          <ul>{p.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </section>
      )}

      {p.funding && <p class="funding">{p.funding}</p>}
    </div>

    <nav class="next" aria-label="More work">
      <a href="/work">All work</a>
      <a href={`/work/${next.slug}`}>Next: {next.title}</a>
    </nav>
  </article>
</Base>

<style>
  .crumb { display: flex; gap: 0.5rem; font-size: 0.9rem; color: var(--muted); margin-bottom: 1.5rem; }
  .head { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 2rem 3rem; align-items: start; padding-bottom: 2.5rem; border-bottom: 1px solid var(--line); }
  .head h1 { font-size: clamp(2rem, 4.5vw, 3rem); margin-bottom: 0.4em; }
  .lede { font-size: 1.15rem; line-height: 1.5; }
  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem 1.5rem; margin: 1.5rem 0 0; }
  .facts dt { font-size: 0.8rem; color: var(--muted); }
  .facts dd { margin: 0.1rem 0 0; font-size: 0.95rem; }
  .art { margin: 0; aspect-ratio: 5 / 3; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; background: var(--surface); }
  .art img { width: 100%; height: 100%; object-fit: cover; display: block; background: #fff; }
  .body { max-width: 46rem; padding-top: 1rem; }
  .body section { margin-top: 2.2rem; }
  .body h2 { font-size: 1.4rem; }
  .body ul { padding-left: 1.2rem; margin: 0 0 1em; }
  .body li { margin-bottom: 0.5rem; max-width: var(--measure); }
  .methods { list-style: none; padding: 0 !important; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .methods li { font-size: 0.8rem; padding: 0.1rem 0.55rem; border-radius: 3px; background: var(--surface); border: 1px solid var(--line); color: var(--muted); margin: 0 !important; }
  .team { list-style: none; padding: 0 !important; display: flex; flex-wrap: wrap; gap: 0.3rem 1.4rem; }
  .team li { margin: 0 !important; }
  .team span { color: var(--muted); }
  .quiet { color: var(--muted); }
  .fig { margin: 2rem 0 0; }
  .fig img { width: 100%; height: auto; display: block; background: #fff; border: 1px solid var(--line); border-radius: 6px; }
  .fig figcaption { font-size: 0.88rem; color: var(--muted); margin-top: 0.5rem; }
  .funding { font-size: 0.85rem; color: var(--muted); margin-top: 2.5rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .next { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  @media (max-width: 760px) { .head { grid-template-columns: minmax(0, 1fr); } .art { order: -1; } }
</style>
