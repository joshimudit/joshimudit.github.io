---
import Base from '../layouts/Base.astro';
import TimeRuler from '../components/TimeRuler.astro';
import ContactForm from '../components/ContactForm.astro';
import CollabMap from '../components/CollabMap.astro';
import { profile, links } from '../data/profile';
import { siGithub, siOrcid } from 'simple-icons';

// 24x24 icon paths for the profile links
const icons: Record<string, string> = {
  LinkedIn: 'M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z',
  ORCID: siOrcid.path,
  GitHub: siGithub.path,
  'AGRI-DRY profile': 'M12 2C7 7 5 11 5 14a7 7 0 0 0 14 0c0-3-2-7-7-12Zm0 18.5a5.5 5.5 0 0 1-5.5-5.5c0-1.6.8-3.9 3-6.9V20a5.4 5.4 0 0 0 2.5.5Z',
};
import { sortedLog, formatMonth } from '../data/log';

const latest = sortedLog.slice(0, 5);
---
<Base>
  <section class="hero wrap">
    <div class="intro">
      <p class="hello">Hello, I’m</p>
      <h1>{profile.name}</h1>
      <p class="lede">{profile.lede}</p>
      <p class="pos">PhD researcher at Aarhus University, part of the {profile.network}.</p>
      <div class="actions">
        <a class="btn" href="#contact">Get in touch</a>
        <ul class="links">
          {links.map((l) => (
            <li><a href={l.href} rel="me"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={icons[l.label]} fill="currentColor" /></svg>{l.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
    <figure class="plate">
      <img src={profile.photo} alt={profile.photoAlt} width="1000" height="750" fetchpriority="high" />
    </figure>
  </section>

  <section class="section wrap" aria-labelledby="time-h">
    <h2 id="time-h">From 400 million years ago to after 2030</h2>
    <p class="muted">My work moves across very different timescales. Pick one to see what I’m working on there.</p>
    <TimeRuler />
  </section>

  <section class="section wrap two" aria-labelledby="about-h">
    <h2 id="about-h">About</h2>
    <div>
      {profile.about.map((p) => <p>{p}</p>)}
      <p><a href="/cv">Read my CV</a> or <a href="/work">see the projects</a>.</p>
    </div>
  </section>

  <section class="section wrap two" aria-labelledby="latest-h">
    <h2 id="latest-h">Latest</h2>
    <div>
      <ol class="log">
        {latest.map((i) => (
          <li>
            <time class="data" datetime={i.date}>{formatMonth(i.date)}</time>
            <span>{i.href ? <a href={i.href}>{i.text}</a> : i.text}</span>
          </li>
        ))}
      </ol>
      <p><a href="/blog#archive">Everything, back to the start</a></p>
    </div>
  </section>

  <section class="section wrap two" id="contact" aria-labelledby="contact-h">
    <div>
      <h2 id="contact-h">Let’s talk</h2>
      <p class="muted">Collaborations, questions about the research, roles in climate, ecosystems, food or AI, or just a good paper you think I should read.</p>
    </div>
    <ContactForm />
  </section>

  <section class="section wrap" aria-labelledby="collab-h">
    <h2 id="collab-h">Current and past collaborations</h2>
    <p class="muted">The universities and organisations I work with now, and the ones that shaped me before.</p>
    <CollabMap />
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: end; padding-block: clamp(2.5rem, 7vw, 6rem) clamp(2.5rem, 5vw, 4rem); }
  .hello { font-family: var(--serif); font-size: 1.35rem; color: var(--ochre); margin: 0 0 0.25rem; }
  h1 { margin-bottom: 0.35em; }
  .lede { font-size: clamp(1.2rem, 2.2vw, 1.5rem); line-height: 1.45; max-width: 34ch; }
  .pos { color: var(--muted); max-width: 52ch; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; margin-top: 1.75rem; }
  .links { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
  .links a { display: inline-flex; align-items: center; gap: 0.45rem; color: var(--ink); text-decoration: none; font-size: 0.95rem; border-bottom: 1px solid transparent; }
  .links a:hover { border-bottom-color: currentColor; }
  .links svg { color: var(--blue); }

  .plate { margin: 0; justify-self: end; width: 100%; max-width: 31rem; }
  .plate img {
    width: 100%; height: auto; display: block; aspect-ratio: 4 / 3; object-fit: cover;
    border-radius: 14px;
    /* a light feather on the edges only, so the photo sits softly on the page */
    -webkit-mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent), linear-gradient(to bottom, transparent, #000 5%, #000 95%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent), linear-gradient(to bottom, transparent, #000 5%, #000 95%, transparent);
    mask-composite: intersect;
  }

  .muted { color: var(--muted); }
  .two { display: grid; grid-template-columns: 1fr 2fr; gap: 1rem 3rem; }
  .two > h2 { margin: 0; }

  .log { list-style: none; padding: 0; margin: 0 0 1.25rem; display: grid; gap: 0.9rem; }
  .log li { display: grid; grid-template-columns: 7.5rem 1fr; gap: 1rem; align-items: baseline; }


  @media (max-width: 760px) {
    .hero, .two { grid-template-columns: 1fr; }
    .plate { justify-self: stretch; order: -1; max-width: none; }
    .log li { grid-template-columns: 1fr; gap: 0.1rem; }
  }
</style>
