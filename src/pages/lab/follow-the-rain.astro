  }

  // ───────────── 4. the coin ─────────────
  {
    const root = $('#p-coin1'), say = $('.say', root), strip = $('.strip', root), tries = $('.tries', root);
    const results: number[] = [];
    $('.go', root).addEventListener('click', () => {
      let h = 100, heads = 0, s = '';
      for (let t = 0; t < 20; t++) { const up = Math.random() < 0.5; h *= up ? 1.5 : 0.6; heads += up ? 1 : 0; s += `<i class="${up ? 'up' : 'down'}">${up ? '▲' : '▼'}</i>`; }
      strip.innerHTML = s;
      const end = h < 10 ? h.toFixed(1) : Math.round(h).toLocaleString('en');
      say.textContent = `${heads} good years and ${20 - heads} droughts. Your 100 cattle became ${end}.`;
      results.push(h);
      const below = results.filter((v) => v < 100).length;
      tries.textContent = results.length > 1 ? `Your tries so far: ${results.slice(-8).map((v) => (v < 10 ? v.toFixed(1) : Math.round(v).toLocaleString('en'))).join(', ')}. Below 100 in ${below} of ${results.length}.` : '';
    });
  }
  {
    const root = $('#p-coin2'), c = $<HTMLCanvasElement>('canvas', root);
    const FAM = 1000, YEARS = 20, GROUP = 15, CAP = 500;
    let mode: 'alone' | 'share' = 'alone', ends: number[] = [], seed = 4, prog = 1, clock: Clock | null = null;
    const fmt = (v: number) => (v < 10 ? v.toFixed(1) : Math.round(v).toLocaleString('en'));
    const sim = () => {
      const r = rng(seed), h = new Float64Array(FAM).fill(100);
      for (let t = 0; t < YEARS; t++) {
        if (mode === 'alone') for (let f = 0; f < FAM; f++) h[f] *= r.next() < 0.5 ? 1.5 : 0.6;
        else for (let g = 0; g < FAM; g += GROUP) {
          let m = 0; const n = Math.min(GROUP, FAM - g);
          for (let k = 0; k < n; k++) m += r.next() < 0.5 ? 1.5 : 0.6;
