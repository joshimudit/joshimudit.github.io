          </ul>
        </div>
      </details>

      <p class="credit">Made by Mudit Joshi as outreach for the Marie Skłodowska-Curie doctoral network <a href="https://agri-dry.org">AGRI-DRY</a>. The way this page explains by playing owes a lot to <a href="https://ncase.me/polygons/">Parable of the Polygons</a> by Vi Hart and Nicky Case.</p>
    </section>
  </article>
</Base>

<script>
  import { W, H, N, K, climate, gradient, rainSeries, rainFromZ, makeWorld, rainYear, grazeYear, simulate, reachable, pieces, rng, type Snap, type Strategy, type World } from '../../lib/range/model';
  import { draw, geo, pal, sceneAt, sceneEnd, playYears, squareAt, type Clock } from '../../lib/range/draw';
  import { lineChart, barChart } from '../../lib/range/charts';
  import { SAHEL_Z } from '../../lib/range/sahel';
  import { CURVE } from '../../lib/range/curve';

  const $ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector(sel) as T;
  const $$ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) => [...root.querySelectorAll(sel)] as T[];
  const STAY = 'var(--stay)', MOVE = 'var(--move)';
  const SEED = 23;                 // the fifty years of rain most of this page uses
  const SAHEL = climate(0.7);      // "Sahel-like": rain swings by roughly 40% a year
  const rainA = rainSeries(50, SAHEL.cv, SEED, 0.2);
  const mask = (rows: string[]) => { const m = new Uint8Array(N); rows.forEach((r, y) => [...r].forEach((ch, x) => { if (ch === '#') m[y * W + x] = 1; })); return m; };
  const count = (m: ArrayLike<number>) => { let n = 0; for (let i = 0; i < m.length; i++) n += m[i] ? 1 : 0; return n; };
