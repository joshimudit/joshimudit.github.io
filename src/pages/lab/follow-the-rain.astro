  // ───────────── a paired run on two maps (used by the bet and by lending) ─────────────
  function totalsOf(snaps: Snap[]) { return snaps.map((s) => s.animals); }
  function drawLoans(c: HTMLCanvasElement, snap: Snap, p: number) {
    if (!snap.loans.length || p < 0.7) return;
    const g = geo(c), cell = g.cell, ctx = c.getContext('2d')!, P = pal();
    const q = Math.min(1, (p - 0.7) / 0.28);
    for (const l of snap.loans) {
      const a = snap.fams[l.from].camps.at(-1)!, b = snap.fams[l.to].camps.at(-1)!;
      const ax = g.sx(a.x + 0.5, a.y + 0.5), ay = g.sy(a.x + 0.5, a.y + 0.5), bx = g.sx(b.x + 0.5, b.y + 0.5), by = g.sy(b.x + 0.5, b.y + 0.5);
