  // ───────────── 2. your herd ─────────────
  {
    const root = $('#p-herd'), c = $<HTMLCanvasElement>('canvas', root), say = $('.say', root);
    const go = $<HTMLButtonElement>('.go', root), best = $<HTMLButtonElement>('.best', root), stayput = $<HTMLButtonElement>('.stayput', root);
    const chartHost = $('.chart-host', root);
    const YEARS = 10, YOU = 6, NB = 7, REACH = 4;
