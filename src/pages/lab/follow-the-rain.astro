  .ftr .pause { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding-block: 1rem; margin-top: 2rem; }
  .ftr .capnote { margin: 0.4rem 0 0; font-size: 0.86rem; color: var(--muted); }
  .ftr section { padding-top: clamp(2.5rem, 7vw, 4.5rem); }
  .ftr h2 { font-size: clamp(1.6rem, 4.6vw, 2.3rem); margin-bottom: 0.7em; }
  .ftr p, .ftr li { max-width: 40rem; }
  .ftr .principle { font-family: var(--serif); font-size: clamp(1.25rem, 3.4vw, 1.6rem); line-height: 1.3; margin-block: 1.6rem; max-width: 36rem; }

  .ftr .play { margin: 1.6rem 0 2rem; padding: 0; }
  .ftr .play.hero { margin-top: 2rem; }
  .ftr figcaption { color: var(--muted); font-size: 0.9rem; margin-top: 0.6rem; max-width: 40rem; }
  .ftr canvas.map { display: block; width: 100%; aspect-ratio: 15 / 9; border-radius: 3px; background: var(--line); touch-action: manipulation; }
  .ftr canvas.map.tap { cursor: pointer; }
  .ftr canvas.fan { display: block; width: 100%; height: 260px; }

  .ftr .bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 0.9rem; margin-top: 0.8rem; }
  .ftr .say { margin: 0; flex: 1 1 16rem; font-size: 0.98rem; line-height: 1.45; min-height: 2.9em; }
  .ftr .say .nums { display: block; color: var(--muted); font-size: 0.92rem; margin-top: 0.2rem; }
  .ftr .verdict { margin-top: 0.9rem; min-height: 0; font-size: 1.05rem; }
  .ftr .btn { min-height: 2.75rem; padding-inline: 1.15rem; font-size: 1rem; }
  .ftr .btn.quiet { background: none; color: var(--ink); box-shadow: inset 0 0 0 1px var(--muted); }
  .ftr .btn.quiet:hover { box-shadow: inset 0 0 0 1px var(--ink); filter: none; }
  .ftr [hidden] { display: none !important; }

  .ftr .key { list-style: none; display: flex; flex-wrap: wrap; gap: 0.3rem 1.2rem; padding: 0; margin: 0.8rem 0 0; font-size: 0.88rem; color: var(--muted); }
  .ftr .key li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .ftr .sw { width: 2.2rem; height: 0.8rem; border-radius: 2px; display: inline-block; }
  .ftr .sw.ramp { background: linear-gradient(90deg, #e6dfd0, #d3cf9c, #8fae5c, #3c7a3e); }
  [data-theme='night'] .ftr .sw.ramp { background: linear-gradient(90deg, #2b2a24, #4a4a2c, #5f7a3c, #a9cf7c); }
  .ftr .sw.rainsw { background: var(--wet); opacity: 0.7; width: 0.9rem; height: 0.9rem; border-radius: 50%; }
  .ftr .sw.fieldsw { width: 0.95rem; height: 0.95rem; background: repeating-linear-gradient(0deg, #cdb98a 0 3px, #8a6f33 3px 4.5px); }
  [data-theme='night'] .ftr .sw.fieldsw { background: repeating-linear-gradient(0deg, #3a3020 0 3px, #7d6a3f 3px 4.5px); }
  .ftr .ic { width: 1.05rem; height: 1.05rem; }
  .ftr .ic.move path { fill: var(--move); }
  .ftr .ic.gone path { fill: none; stroke: var(--muted); stroke-width: 1.5; stroke-dasharray: 2 2; }

  .ftr .fact { border-left: 3px solid var(--line); padding: 0.15rem 0 0.15rem 1rem; margin: 1.8rem 0; }
  .ftr .fact p { margin: 0; font-size: 0.97rem; color: var(--muted); max-width: 37rem; }
  .ftr .fact strong { color: var(--ink); font-weight: 600; }

  .ftr .rules { padding-left: 1.1rem; }
  .ftr .rules li { margin-bottom: 0.5rem; }

  .ftr .tally { display: flex; flex-wrap: wrap; gap: 0.4rem 2rem; margin-bottom: 0.5rem; }
  .ftr #p-herd > .say { margin-bottom: 0.7rem; min-height: 3em; }
  .ftr .who { display: grid; grid-template-columns: auto auto; column-gap: 0.45rem; align-items: center; }
