      else if (a > b) text = `After ten years you have ${a} cattle and your neighbour has ${b}${nb.out ? ', having given up herding' : ''}. ${peak > a ? `Your neighbour was ahead for much of that time, and reached ${peak} before the dry years came.` : 'Walking cost you something every year and still came out ahead.'}`;
