      $('[data-r="mid"]', root).textContent = fmt((ends[FAM / 2 - 1] + ends[FAM / 2]) / 2) + ' cattle';
      $('[data-r="avg"]', root).textContent = fmt(ends.reduce((a, b) => a + b, 0) / FAM) + ' cattle';
    };
    const paint = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2.5), wd = c.clientWidth, ht = Math.round(Math.min(300, Math.max(220, wd * 0.5)));
      c.style.height = ht + 'px';
