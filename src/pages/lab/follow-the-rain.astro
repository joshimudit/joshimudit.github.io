  // ───────────── 1. the rain ─────────────
  {
    const root = $('#p-rain'), c = $<HTMLCanvasElement>('canvas', root), say = $('.say', root), go = $<HTMLButtonElement>('.go', root);
    const w = makeWorld({ seed: 5, strategies: 'move' });
    const first = [1.05, 0.62, 1.45, 0.34];
    const r = rng(77);
    let year = 0, prev = new Float64Array(N), clock: Clock | null = null;
