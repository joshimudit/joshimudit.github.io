    });
    const paint = () => draw(c, { grass: phase === 'idle' ? calm : phase === 'pick' ? w.grass : w.left, owned: w.owned, herds: herds(), ring: phase === 'pick' ? ring : null, cursor: phase === 'pick' ? cursor : null });
