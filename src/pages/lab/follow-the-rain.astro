      const ctx = c.getContext('2d')!, P = pal(), css = getComputedStyle(root);
      const wet = css.getPropertyValue('--wet').trim(), dry = css.getPropertyValue('--dry').trim();
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, wd, ht);
      const m = { l: 4, r: 4, t: 30, b: 26 }, BARS = 100, bw = (wd - m.l - m.r) / BARS;
      const Y = (v: number) => ht - m.b - (Math.min(v, CAP) / CAP) * (ht - m.t - m.b);
      ctx.font = `12px ${getComputedStyle(document.body).fontFamily}`;
      ctx.textBaseline = 'alphabetic';
      for (let k = 0; k < BARS; k++) {
        let v = 0;
        for (let j = 0; j < FAM / BARS; j++) v += ends[k * (FAM / BARS) + j];
        v = (v / (FAM / BARS)) * prog + 100 * (1 - prog);
        ctx.fillStyle = v < 100 ? dry : wet;
        const y = Y(v);
        ctx.fillRect(m.l + k * bw + 0.5, y, Math.max(1, bw - 1), ht - m.b - y);
        if (v > CAP && prog >= 1) { // taller than the chart: a small arrow on top
          ctx.beginPath(); ctx.moveTo(m.l + (k + 0.5) * bw - 3, m.t - 3); ctx.lineTo(m.l + (k + 0.5) * bw, m.t - 9); ctx.lineTo(m.l + (k + 0.5) * bw + 3, m.t - 3); ctx.fill();
        }
      }
      // the line everyone started on
      ctx.strokeStyle = P.ink; ctx.lineWidth = 1.5; ctx.setLineDash([5, 4]);
      ctx.beginPath(); ctx.moveTo(m.l, Y(100)); ctx.lineTo(wd - m.r, Y(100)); ctx.stroke(); ctx.setLineDash([]);
      ctx.fillStyle = P.ink; ctx.textAlign = 'left';
      ctx.fillText('everyone started with 100', m.l + 2, Y(100) - 6);
      ctx.fillStyle = P.muted;
      ctx.fillText('unluckiest', m.l, ht - 8);
      ctx.textAlign = 'right'; ctx.fillText('luckiest', wd - m.r, ht - 8);
      if (prog >= 1 && ends[FAM - 1] > CAP) { ctx.fillStyle = P.ink; ctx.fillText(`the luckiest family has ${fmt(ends[FAM - 1])}`, wd - m.r, 12); }
    };
    const run = () => {
      clock?.stop(); sim(); prog = 0;
      clock = playYears(1, 900, (_t, p) => { prog = p * p * (3 - 2 * p); paint(); }, () => { prog = 1; paint(); });
    };
    $$<HTMLButtonElement>('.seg button', root).forEach((b) => b.addEventListener('click', () => {
      mode = b.dataset.mode as 'alone' | 'share';
      $$('.seg button', root).forEach((x) => x.classList.toggle('on', x === b));
      run();
    }));
    $('.go', root).addEventListener('click', () => { seed = Math.floor(Math.random() * 1e6) + 1; run(); });
    sim();
    onRepaint(() => { if (!clock?.running) paint(); });
  }

  // ───────────── 5. the dial ─────────────
  {
    const root = $('#p-dial'), host = $('.chart-host', root), dial = $<HTMLInputElement>('input', root), say = $('.say', root);
    const NSVG = 'http://www.w3.org/2000/svg';
    const chart = lineChart(host, {
      x0: 0, x1: 10, yMax: 15, xTicks: [0, 10], yTicks: [0, 5, 10, 15], height: 270,
      xFmt: (v) => (v === 0 ? 'steady rain' : v === 10 ? 'wild rain' : ''), yFmt: (v) => v.toFixed(1), yTickFmt: (v) => String(Math.round(v)),
      yLabel: 'families still herding after 50 years',
      marks: [{ x: 1.7, label: 'West African coast' }, { x: 6.5, label: 'northern Sahel' }],
      series: [
        { key: 'stay', label: 'Stays', color: STAY, dash: '6 4', values: CURVE.map((r) => r.stayFamilies) },
        { key: 'move', label: 'Moves', color: MOVE, values: CURVE.map((r) => r.moveFamilies) },
      ],
      tip: (_x, vals) => vals.map((q) => `<span><i style="background:${q.s.color}"></i>${q.s.label}: ${q.v.toFixed(1)} families</span>`).join(''),
    });
    const marker = document.createElementNS(NSVG, 'g') as SVGGElement;
    marker.setAttribute('class', 'pick');
    chart.svg.insertBefore(marker, chart.svg.querySelector('.hover'));
    const update = () => {
      const u = +dial.value, r = CURVE[u];
      const x = chart.X(u), ys = chart.Y(r.stayFamilies), ym = chart.Y(r.moveFamilies);
      marker.innerHTML = `<line x1="${x}" x2="${x}" y1="30" y2="${chart.Y(0)}" class="cross"/><circle cx="${x}" cy="${ys}" r="6" fill="${STAY}" class="dot"/><circle cx="${x}" cy="${ym}" r="6" fill="${MOVE}" class="dot"/>`;
      const regime = u <= 2 ? 'Steady rain. Staying works. Almost every family is still there after 50 years, and nobody had to walk.'
        : u <= 4 ? 'In between. The village that stays has started to lose families.'
        : 'Wild rain. The village that stays loses most of its families. The village that moves keeps nearly all of them.';
      say.innerHTML = `${regime} <span class="nums">Families left, out of 15: ${r.stayFamilies.toFixed(1)} if they stay, ${r.moveFamilies.toFixed(1)} if they move. Each number is the average of 60 different runs of rain.</span>`;
    };
    dial.addEventListener('input', update);
    update();
  }

  // ───────────── 6. fences ─────────────
  const LAY: Record<string, Uint8Array> = {
    open: new Uint8Array(N),
    block: (() => { const m = new Uint8Array(N); for (let i = N - 31; i < N; i++) m[i] = 1; return m; })(),
    walls: mask(['.....#...#.....', '.....#...#.....', '.....#...#.....', '###############', '.....#...#.....', '.....#...#.....', '.....#...#.....', '.....#...#.....', '.....#...#.....']),
    gates: mask(['.....#...#.....', '...............', '.....#...#.....', '##.####.####.##', '.....#...#.....', '.....#...#.....', '...............', '.....#...#.....', '####.#...#.###.']),
  };
  const LAYNAME: Record<string, string> = { open: 'Open land', block: '31 fields in a block', walls: '31 fields in strips', gates: 'Strips with gaps' };
  const eightRains = [SEED, 31, 32, 33, 34, 35, 36, 37].map((s) => ({ seed: s, rain: s === SEED ? rainA : rainSeries(50, SAHEL.cv, s, 0.2) }));
  {
    const root = $('#p-fence'), c = $<HTMLCanvasElement>('canvas', root), say = $('.say', root), go = $<HTMLButtonElement>('.go', root), skip = $<HTMLButtonElement>('.skip', root);
    const table = $<HTMLTableElement>('.scores', root), tbody = $('tbody', table);
    let closed = Uint8Array.from(LAY.open), lay = 'open', snaps: Snap[] | null = null, clock: Clock | null = null, shown = 0;
    const scores = new Map<string, { name: string; v: number; fields: number }>();
    const startHerds = () => makeWorld({ seed: SEED, strategies: 'move' }).families.map((f) => ({ id: f.id, strategy: f.strategy, x: f.x, y: f.y, herd: f.herd }));
    const describe = () => {
      const n = count(closed), p = pieces(closed);
      say.textContent = n === 0 ? 'No fields. All the land is open.' : `${n} field${n === 1 ? '' : 's'}. The open land is in ${p === 1 ? 'one piece' : p + ' separate pieces'}.`;
    };
    const paint = () => { if (snaps) draw(c, sceneEnd(snaps, shown, { closed })); else draw(c, { grass: calm, closed, herds: startHerds() }); };
    const setLay = (k: string) => {
      clock?.stop(); snaps = null; lay = k; closed = Uint8Array.from(LAY[k]);
      $$('.seg button', root).forEach((x) => x.classList.toggle('on', (x as HTMLElement).dataset.lay === k));
      go.hidden = false; skip.hidden = true; go.textContent = 'Run 50 years';
      describe(); paint();
    };
    $$<HTMLButtonElement>('.seg button', root).forEach((b) => b.addEventListener('click', () => setLay(b.dataset.lay!)));
    c.addEventListener('click', (e) => {
      if (clock?.running) return;
      const i = squareAt(c, e); if (i < 0) return;
      snaps = null; closed[i] = closed[i] ? 0 : 1;
      lay = Object.keys(LAY).find((k) => LAY[k].every((v, j) => v === closed[j])) ?? 'custom';
      $$('.seg button', root).forEach((x) => x.classList.toggle('on', (x as HTMLElement).dataset.lay === lay));
      go.textContent = 'Run 50 years';
      describe(); paint();
    });
    const renderScores = () => {
      table.hidden = false;
      tbody.innerHTML = [...scores.values()].map((s) => `<tr><th scope="row">${s.name}</th><td class="barcell"><span style="width:${(s.v / 15) * 100}%"></span></td><td class="num">${s.v.toFixed(1)}</td></tr>`).join('');
    };
    go.addEventListener('click', () => {
      if (clock?.running) return;
      const mine = Uint8Array.from(closed);
      snaps = sim50({ seed: SEED, strategies: 'move', closed: mine }, rainA, SAHEL.storms).snaps;
      let sum = snaps[50].herding;
      for (const r of eightRains.slice(1)) sum += simulate({ seed: r.seed, strategies: 'move', closed: mine }, r.rain, SAHEL.storms).snaps[50].herding;
      const avg = sum / eightRains.length, n = count(mine), p = pieces(mine);
      const key = lay === 'custom' ? [...mine].join('') : lay;
      scores.delete(key);
      scores.set(key, { name: lay === 'custom' ? `Your layout: ${n} fields, ${p} piece${p === 1 ? '' : 's'}` : LAYNAME[lay], v: avg, fields: n });
      while (scores.size > 6) scores.delete(scores.keys().next().value!);
      go.hidden = true; skip.hidden = false; shown = 0;
      c.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      clock = playYears(50, 190, (t, p2) => {
        draw(c, sceneAt(snaps!, t, p2, { closed: mine }));
        if (t !== shown) { shown = t; say.textContent = `Year ${t}: ${snaps![t - 1].herding} of 15 families still herding.`; }
      }, () => {
        shown = 50; paint(); go.hidden = false; skip.hidden = true; go.textContent = 'Run it again';
        say.textContent = `This time, ${snaps![50].herding} of 15 families were still herding after 50 years. The average of eight different runs of rain is ${avg.toFixed(1)}.`;
        renderScores();
      });
    });
    skip.addEventListener('click', () => clock?.finish());
    describe();
    onRepaint(() => { if (!clock?.running) paint(); });
  }

  // ───────────── 7. lending ─────────────
  {
    const root = $('#p-lend'), ca = $<HTMLCanvasElement>('[data-m="a"]', root), cb = $<HTMLCanvasElement>('[data-m="b"]', root);
    const say = $('.say', root), go = $<HTMLButtonElement>('.go', root), skip = $<HTMLButtonElement>('.skip', root), yr = $('.yr', root);
    const a = sim50({ seed: SEED, strategies: 'stay' }, rainA, SAHEL.storms), b = sim50({ seed: SEED, strategies: 'stay', lend: true }, rainA, SAHEL.storms);
    const A = a.snaps, B = b.snaps, owned = a.world.owned;
    let shown = 0, clock: Clock | null = null;
    const counts = (t: number) => { $('[data-c="a"]', root).textContent = String(A[t].herding); $('[data-c="b"]', root).textContent = String(B[t].herding); };
    const still = (t: number) => { draw(ca, sceneEnd(A, t, { owned })); draw(cb, sceneEnd(B, t, { owned })); counts(t); };
    go.addEventListener('click', () => {
      if (clock?.running) return;
      go.hidden = true; skip.hidden = false; say.textContent = ''; shown = 0;
      clock = playYears(50, 230, (t, p) => {
        draw(ca, sceneAt(A, t, p, { owned })); draw(cb, sceneAt(B, t, p, { owned })); drawLoans(cb, B[t], p);
        if (t !== shown) { shown = t; counts(t - 1); yr.textContent = `Year ${t}`; }
      }, () => {
        shown = 50; still(50); yr.textContent = 'Year 50'; go.hidden = false; skip.hidden = true; go.textContent = 'Watch again';
        const lent = Math.round(b.world.lentTotal);
        say.textContent = `Without lending, ${A[50].herding} families are left. With lending, ${B[50].herding}. In 50 years, ${lent} cattle were lent. That is only two or three a year.`;
      });
    });
    skip.addEventListener('click', () => clock?.finish());
    onRepaint(() => { if (!clock?.running) still(shown); });
  }

  // ───────────── 8. your turn ─────────────
  {
    const root = $('#p-own'), c = $<HTMLCanvasElement>('canvas', root), say = $('.say', root), status = $('.status', root);
    const go = $<HTMLButtonElement>('.go', root), skip = $<HTMLButtonElement>('.skip', root), yr = $('.yr', root), wx = $('.wx', root), lendBox = $<HTMLInputElement>('.lend', root);
    const LIMIT = 3, NEED = 31, GOAL = 12, REPLAYS = [201, 202, 203, 204, 205], STORMS = 13;
    const START = mask(['...............', '...............', '...............', '###############', '.....#...#.....', '.....#...#....#', '#####....#.....', '.....#...#....#', '.....#...#.....']);
    const BLOCK = (() => { const m = new Uint8Array(N); for (let i = N - 30; i < N; i++) m[i] = 1; m[6 * W] = 1; return m; })();
    const GATES = mask(['...............', '...............', '...............', '##.####.####.##', '.....#...#.....', '...............', '###............', '#....#...#....#', '####.#...#.####']);
    const startStrat = (): Strategy[] => Array.from({ length: 15 }, (_, i) => (i >= 6 ? 'stay' : 'move'));
    const realYears = Array.from({ length: 51 }, (_, k) => 1950 + k);
    const realRain = rainFromZ(realYears.map((y) => SAHEL_Z[y]), 0.3);
    let closed = Uint8Array.from(START), strat = startStrat(), tapMode: 'family' | 'field' = 'family';
    let snaps: Snap[] | null = null, shown = 0, clock: Clock | null = null;
    const bars = barChart($('.rainbar', root), {
      x0: 1950, values: realYears.map((y) => SAHEL_Z[y]), yMax: 3, xTicks: [1950, 1960, 1970, 1980, 1990, 2000], height: 110,
      pos: 'var(--wet)', neg: 'var(--dry)', tip: (x, v) => `<b>${x}</b><span>${zWord(v)}</span>`,
    });
    const ownedOf = () => { const o = new Int16Array(N).fill(-1); strat.forEach((s, t) => { if (s !== 'stay') return; const x = (t % 5) * 3 + 1, y = Math.floor(t / 5) * 3 + 1; for (let dy = -1; dy <= 1; dy++) for (let dx = -1; dx <= 1; dx++) o[(y + dy) * W + x + dx] = t; }); return o; };
    const limitLine = () => {
      const g = geo(c), ctx = c.getContext('2d')!, P = pal();
      ctx.strokeStyle = P.ink; ctx.lineWidth = 2; ctx.setLineDash([2, 5]);
      ctx.beginPath(); ctx.moveTo(g.sx(0, LIMIT), g.sy(0, LIMIT)); ctx.lineTo(g.sx(W, LIMIT), g.sy(W, LIMIT)); ctx.stroke(); ctx.setLineDash([]);
    };
    const paint = () => {
      const owned = ownedOf();
      if (snaps) draw(c, sceneEnd(snaps, shown, { closed, owned }));
      else draw(c, { grass: calm, closed, owned, herds: strat.map((s, t) => ({ id: t, strategy: s, x: (t % 5) * 3 + 1, y: Math.floor(t / 5) * 3 + 1, herd: K.start })) });
      limitLine();
    };
    const describe = () => {
      const n = count(closed), st = strat.filter((s) => s === 'stay').length;
      status.innerHTML = `<b>${n}</b> of ${NEED} fields. <b>${st}</b> ${st === 1 ? 'family stays' : 'families stay'}, <b>${15 - st}</b> move.`;
    };
    const edited = () => { clock?.stop(); snaps = null; go.hidden = false; skip.hidden = true; go.textContent = 'Run 1950 to 2000'; yr.textContent = ''; wx.textContent = ''; say.textContent = ''; bars.at(null); describe(); paint(); };
    $$<HTMLButtonElement>('[data-tap]', root).forEach((b) => b.addEventListener('click', () => {
      $$('[data-tap]', root).forEach((x) => x.classList.toggle('on', x === b));
      tapMode = b.dataset.tap as typeof tapMode;
    }));
    $$<HTMLButtonElement>('[data-set]', root).forEach((b) => b.addEventListener('click', () => {
      const v = b.dataset.set;
      if (v === 'allmove') strat = Array(15).fill('move');
      if (v === 'block') closed = Uint8Array.from(BLOCK);
      if (v === 'gates') closed = Uint8Array.from(GATES);
      if (v === 'reset') { closed = Uint8Array.from(START); strat = startStrat(); lendBox.checked = false; }
      edited();
      c.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }));
    lendBox.addEventListener('change', edited);
    c.addEventListener('click', (e) => {
      if (clock?.running) return;
      const i = squareAt(c, e); if (i < 0) return;
      const x = i % W, y = Math.floor(i / W);
      if (tapMode === 'family') { const t = Math.floor(y / 3) * 5 + Math.floor(x / 3); strat[t] = strat[t] === 'stay' ? 'move' : 'stay'; edited(); }
      else if (y < LIMIT && !closed[i]) { edited(); say.textContent = 'Too dry for crops on that side of the dotted line.'; }
      else { closed[i] = closed[i] ? 0 : 1; edited(); }
    });
    go.addEventListener('click', () => {
      if (clock?.running) return;
      const mine = Uint8Array.from(closed), st = [...strat], lend = lendBox.checked, owned = ownedOf();
      const runs = REPLAYS.map((seed) => sim50({ seed, strategies: st, closed: mine, lend }, realRain, STORMS).snaps);
      snaps = runs[0];
      const T = snaps.length - 1, avg = runs.reduce((a, r) => a + r[T].herding, 0) / runs.length;
      go.hidden = true; skip.hidden = false; say.textContent = ''; shown = 0;
      c.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      clock = playYears(T, 190, (t, p) => {
        draw(c, sceneAt(snaps!, t, p, { closed: mine, owned })); if (lend) drawLoans(c, snaps![t], p); limitLine();
        if (t !== shown) { shown = t; yr.textContent = String(1949 + t); wx.textContent = `${snaps![t - 1].herding} families herding`; bars.at(1949 + t); }
      }, () => {
        shown = T; paint(); go.hidden = false; skip.hidden = true; go.textContent = 'Run it again';
        yr.textContent = '2000'; wx.textContent = '';
        const n = count(mine), settled = st.filter((x) => x === 'stay').length;
        let text = `Storms land in different places each time, so the 50 years were played five times. On average, ${avg.toFixed(1)} of 15 families were still herding in 2000.`;
        if (n < NEED) text += ` But the towns need ${NEED} fields, and you left them ${n}.`;
        else if (avg >= GOAL && settled >= 3) text += ' You did the hard version: the towns have their fields, some families have their wells, and the herders are still there.';
        else if (avg >= GOAL) text += ' You did it. The fields are all still there, and so are the herders. Now try the hard version: reach 12 with three families settled. Which three, and where?';
        else if (avg >= 9) text += ' Close. Look for families that are fenced in, or settled where there is little rain.';
        else text += ' Most families did not make it through the drought. Give the herds a way through, or let more families move.';
        say.textContent = text;
      });
    });
    skip.addEventListener('click', () => clock?.finish());
    describe();
    onRepaint(() => { if (!clock?.running) paint(); });
  }
</script>

<style is:global>
  .ftr {
    --stay: #a85a06; --move: #00789a; --wet: #3f6fb0; --dry: #b0813a;
    width: min(100% - 2rem, 46rem); margin-inline: auto; padding-block: clamp(2rem, 6vw, 4.5rem) 4rem;
  }
  [data-theme='night'] .ftr { --stay: #c98427; --move: #2a9cba; --wet: #8fb4e8; --dry: #c9a05a; }

  .ftr h1 { font-size: clamp(2.6rem, 9vw, 4.6rem); margin-bottom: 0.35em; }
