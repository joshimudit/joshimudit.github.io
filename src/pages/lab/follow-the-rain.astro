  // ───────────── 3. the bet ─────────────
  {
    const root = $('#p-bet'), stage = $('.stage', root), verdict = $('.verdict', root), ends = $('.ends', root);
    const cs = $<HTMLCanvasElement>('[data-m="stay"]', root), cm = $<HTMLCanvasElement>('[data-m="move"]', root);
    const yr = $('.yr', root), wx = $('.wx', root), skip = $<HTMLButtonElement>('.skip', root);
    let bet = '', seed = SEED, A: Snap[], B: Snap[], owned: Int16Array, rain = rainA, clock: Clock | null = null, shown = 0, chart: ReturnType<typeof lineChart> | null = null;
    const sim = () => {
