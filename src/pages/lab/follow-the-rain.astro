      const won = m > s + 1 ? 'move' : s > m + 1 ? 'stay' : 'same';
      const name: Record<string, string> = { stay: 'the village that stays', move: 'the village that moves', same: 'about the same' };
      let text = `You bet on ${name[bet]}. After 50 years, ${s} of the 15 families that stayed still live from their herds. Of the families that moved, ${m} do.`;
      text += bet === won ? ' You called it.' : ' Not this time.';
