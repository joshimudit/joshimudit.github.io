  .sources { margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .sources ul { list-style: none; padding: 0; margin: 0 0 1.2rem; font-size: 0.9rem; }
  .sources li { padding: 0.35rem 0; border-bottom: 1px dotted var(--line); }
