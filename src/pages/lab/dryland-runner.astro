  .meter.low .num { color: var(--ochre); font-weight: 600; }
  .t-water { color: #1f6fa3; } .t-food { color: var(--ochre); }
  :global([data-theme='night']) .t-water { color: #7cc0ea; }

  .stage { position: relative; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; touch-action: manipulation; user-select: none; -webkit-user-select: none; }
  #cv { display: block; width: 100%; aspect-ratio: 960 / 400; cursor: pointer; }
  .stage { scroll-margin-top: 4rem; }
  .banner { position: absolute; left: 50%; top: 0.8rem; transform: translateX(-50%); margin: 0; padding: 0.35rem 0.7rem; font-size: 0.85rem; font-weight: 500; color: var(--ink); background: color-mix(in srgb, var(--ochre-soft) 92%, transparent); border: 1px solid var(--ochre); border-radius: 3px; white-space: nowrap; }
  .pause { position: absolute; right: 0.6rem; top: 0.6rem; font: inherit; font-size: 0.8rem; padding: 0.3rem 0.6rem; background: color-mix(in srgb, var(--surface) 85%, transparent); color: var(--ink); border: 1px solid var(--line); border-radius: 3px; cursor: pointer; }

  .ov { position: absolute; inset: 0; display: grid; place-items: center; padding: 1rem; background: color-mix(in srgb, var(--bg) 55%, transparent); overflow: auto; }
  .ov[hidden] { display: none; }
  .ov-box { max-width: 34rem; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 1.4rem 1.5rem; }
  .ov-box.wide { max-width: 58rem; width: 100%; }
  .ov-box h2 { font-size: clamp(1.3rem, 2.6vw, 1.7rem); margin: 0 0 0.5rem; }
  .ov-box p { margin: 0 0 0.75rem; }
  .keys { color: var(--muted); font-size: 0.88rem; }
  .sit { color: var(--muted); }
  .opts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; }
  :global(.opt) { position: relative; display: flex; flex-direction: column; gap: 0.4rem; text-align: left; font: inherit; color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 4px; padding: 0.85rem 0.9rem 0.9rem; cursor: pointer; }
  :global(.opt:hover), :global(.opt:focus-visible) { border-color: var(--blue); outline: none; box-shadow: inset 0 0 0 1px var(--blue); }
  :global(.opt strong) { font-family: var(--serif); font-weight: 400; font-size: 1.12rem; padding-right: 1.4rem; }
  :global(.o-key) { position: absolute; right: 0.7rem; top: 0.7rem; font-family: var(--mono); font-size: 0.7rem; color: var(--muted); }
  :global(.o-gain) { font-size: 0.9rem; }
  :global(.o-cost) { font-size: 0.9rem; color: var(--ochre); }
  :global(.o-real) { font-size: 0.8rem; color: var(--muted); border-top: 1px dotted var(--line); padding-top: 0.45rem; margin-top: auto; }

  .turn { display: none; margin: 0.5rem 0 0; font-size: 0.85rem; color: var(--muted); }
  @media (max-width: 600px) and (orientation: portrait) { .turn { display: block; } }
  .chosen-line { margin: 0.6rem 0 0; font-size: 0.9rem; }
  .chosen-line .lab { color: var(--muted); }

  .end { scroll-margin-top: 5rem; margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .end h2 { margin-bottom: 0.4rem; }
  .e-text { max-width: var(--measure); }
  .chart { margin: 1.2rem 0 1.5rem; }
  .chart svg { width: 100%; height: auto; display: block; }
  .chart figcaption { font-size: 0.85rem; color: var(--muted); display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem 0.5rem; }
  .k { display: inline-block; width: 1.1rem; height: 3px; margin-left: 0.4rem; vertical-align: middle; }
  .k-rain { background: none; border-top: 2px dashed var(--moss); height: 0; }
  .k-water { background: #1f6fa3; } .k-food { background: var(--ochre-fill); }
  .k-spell { height: 0.7rem; width: 0.7rem; background: var(--ochre-soft); }
  :global([data-theme='night']) .k-water { background: #7cc0ea; }
  #e-chart :global(.c-bg) { fill: var(--surface); stroke: var(--line); }
