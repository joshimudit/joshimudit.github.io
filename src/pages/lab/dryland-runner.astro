  @media (max-width: 800px) {
    .opts { grid-template-columns: 1fr; }
    .notes { grid-template-columns: 1fr; }
    .meters { grid-template-columns: 1fr; max-width: none; }
    .ov { position: fixed; z-index: 50; place-items: start center; background: color-mix(in srgb, var(--bg) 94%, transparent); padding-top: 3rem; }
    .ov-box { padding: 1rem; }
  }
</style>
