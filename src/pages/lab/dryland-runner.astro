  #e-chart :global(.c-ref) { fill: none; stroke: var(--moss); stroke-width: 2; stroke-dasharray: 5 4; }
  #e-chart :global(.c-water) { fill: none; stroke: #1f6fa3; stroke-width: 2; }
  #e-chart :global(.c-food) { fill: none; stroke: var(--ochre-fill); stroke-width: 2; }
  :global([data-theme='night']) #e-chart :global(.c-water) { stroke: #7cc0ea; }
  #e-chart :global(.c-ax) { font: 10px var(--sans); fill: var(--muted); }
  #e-chart :global(.c-tick) { stroke: var(--ink); stroke-width: 1.5; }
  #e-chart :global(.c-choice) { font: 10.5px var(--sans); fill: var(--ink); }
  #e-chart :global(.c-end) { stroke: var(--ink); stroke-width: 1.5; stroke-dasharray: 2 3; }
  .real { max-width: var(--measure); }
  .real h3 { margin-bottom: 0.4rem; }
  .real ul { padding-left: 1.1rem; margin: 0 0 1.4rem; }
  .real li { margin-bottom: 0.35rem; }

  .notes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 3rem; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .notes h2, .sources h2 { font-size: 1.35rem; }
  .notes ol { padding-left: 1.2rem; margin: 0; }
