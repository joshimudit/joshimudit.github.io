---
import Base from '../../layouts/Base.astro';
---
<Base title="Patch, a pocket-sized vegetation model" description="Change the climate and watch one square metre of grassland respond, day by day. A playable, process-based vegetation model for teaching and outreach.">
  <div class="wrap page patch-page">
    <header class="page-head">
      <p class="crumb"><a href="/lab">Lab</a></p>
      <h1>Patch</h1>
      <p>A pocket-sized vegetation model. Change the climate and watch one square metre of grassland respond, one day at a time. Tap any label in the scene to see what is going on inside.</p>
    </header>

    <div class="layout">
      <div class="stage">
        <div class="scene-wrap">
          <svg id="scene" viewBox="0 0 800 460" role="img" aria-label="Animated cross-section of a grassland patch: sky, plants, and soil with water, roots and carbon">
            <rect id="sky" x="0" y="0" width="800" height="262" />
            <g id="stars"></g>
            <circle id="sun" cx="660" cy="80" r="30" />
            <g id="rain"></g>
            <g id="co2"></g>
            <g id="vapour"></g>
            <rect id="soil" x="0" y="262" width="800" height="198" />
            <rect id="soilc" x="0" y="268" width="800" height="40" />
            <rect id="water" x="0" y="400" width="800" height="60" />
            <line id="bucket-line" x1="0" x2="800" y1="268" y2="268" />
            <g id="roots"></g>
            <rect id="litter" x="0" y="258" width="800" height="6" />
            <rect id="snow" x="0" y="252" width="800" height="0" />
            <g id="plants"></g>
            <g id="decomp"></g>
          </svg>
          <button class="hot" style="left:24%;top:30%" data-box="photosynthesis">Photosynthesis</button>
          <button class="hot" style="left:63%;top:47%" data-box="growth">Growth</button>
          <button class="hot" style="left:13%;top:60%" data-box="decomposition">Decomposition</button>
          <button class="hot" style="left:72%;top:86%" data-box="water">Soil water</button>
          <button class="hot" style="left:30%;top:74%" data-box="soilcarbon">Soil carbon</button>
          <p class="clock" aria-live="off"><span id="t-date">Year 1, January</span><span id="t-temp">0 °C</span></p>
        </div>

        <div class="transport">
          <button id="play" class="btn" type="button">Pause</button>
          <div class="speed" role="group" aria-label="Speed">
            <button type="button" data-speed="10" aria-pressed="true">Normal</button>
            <button type="button" data-speed="45" aria-pressed="false">Fast</button>
          </div>
          <button id="reset" class="ghost" type="button">Start over</button>
        </div>

        <section class="limits" aria-labelledby="lim-h">
          <h2 id="lim-h">What is holding growth back today?</h2>
          <div class="meters">
            <div class="meter"><span>Light</span><div class="bar"><i id="m-light"></i></div></div>
            <div class="meter"><span>Water</span><div class="bar"><i id="m-water"></i></div></div>
            <div class="meter"><span>Temperature</span><div class="bar"><i id="m-temp"></i></div></div>
          </div>
          <p class="verdict"><strong id="v-limit">—</strong> <span id="v-co2"></span></p>
        </section>
      </div>

      <aside class="controls" aria-label="Climate controls">
        <h2>Set the climate</h2>
        <label class="ctl">
          <span class="lab">Average temperature <output id="o-temp">10 °C</output></span>
          <input id="i-temp" type="range" min="-2" max="26" step="1" value="10" />
          <span class="ends"><span>Arctic</span><span>Tropical</span></span>
        </label>
        <label class="ctl">
          <span class="lab">Rainfall per year <output id="o-rain">700 mm</output></span>
          <input id="i-rain" type="range" min="100" max="1600" step="50" value="700" />
          <span class="ends"><span>Desert</span><span>Rainforest</span></span>
        </label>
        <label class="ctl">
          <span class="lab">CO₂ in the air <output id="o-co2">420 ppm</output></span>
          <input id="i-co2" type="range" min="180" max="900" step="10" value="420" list="co2-marks" />
          <datalist id="co2-marks"><option value="180"></option><option value="280"></option><option value="420"></option></datalist>
          <span class="ends"><span>Ice Age</span><span>Today: 420</span><span>Future</span></span>
        </label>
        <label class="ctl">
          <span class="lab">Soil <output id="o-soil">Loam</output></span>
          <input id="i-soil" type="range" min="50" max="230" step="10" value="150" />
          <span class="ends"><span>Sand, drains fast</span><span>Clay, holds water</span></span>
        </label>

        <div class="presets">
          <h3>Try this</h3>
          <div class="preset-row">
            <button type="button" data-preset="today">Today</button>
            <button type="button" data-preset="preind">Before industry</button>
            <button type="button" data-preset="ice">Ice Age</button>
            <button type="button" data-preset="double">Double CO₂</button>
            <button type="button" data-preset="drought">Drought</button>
            <button type="button" data-preset="hot">8 °C hotter</button>
          </div>
          <p id="preset-note" class="note">Pick a scenario. The patch keeps its history, so watch how fast plants respond and how slowly the soil does.</p>
        </div>
      </aside>
    </div>

    <section class="box" aria-labelledby="box-h">
      <div class="box-tabs" role="tablist" aria-label="Processes">
        <button role="tab" data-box="photosynthesis" aria-selected="true">Photosynthesis</button>
        <button role="tab" data-box="water" aria-selected="false">Soil water</button>
        <button role="tab" data-box="growth" aria-selected="false">Growth</button>
        <button role="tab" data-box="decomposition" aria-selected="false">Decomposition</button>
        <button role="tab" data-box="soilcarbon" aria-selected="false">Soil carbon</button>
      </div>
      <div class="box-body" role="tabpanel">
        <h2 id="box-h">Open the box: <span id="b-title">Photosynthesis</span></h2>
        <div class="box-cols">
          <div><h3>In plain words</h3><p id="b-plain"></p></div>
          <div><h3>In Patch</h3><p id="b-toy"></p><p class="eq" id="b-eq"></p></div>
          <div><h3>In a full model like LPJmL</h3><p id="b-model"></p></div>
        </div>
      </div>
    </section>

    <section class="results" aria-labelledby="res-h">
      <h2 id="res-h">What the patch did</h2>
      <div class="charts">
        <figure>
          <figcaption>Plant carbon above ground, last three years <span class="data" id="c-plant-v"></span></figcaption>
          <svg viewBox="0 0 400 120" class="chart" id="c-plant" aria-hidden="true"><polyline /></svg>
        </figure>
        <figure>
          <figcaption>Carbon stored in the soil <span class="data" id="c-soil-v"></span></figcaption>
          <svg viewBox="0 0 400 120" class="chart" id="c-soil" aria-hidden="true"><polyline /></svg>
        </figure>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">Year</th><th scope="col">Carbon captured</th><th scope="col">Plant growth</th><th scope="col">Water used</th><th scope="col">Water drained</th><th scope="col">Soil carbon</th></tr></thead>
          <tbody id="years"><tr><td colspan="6">Results appear after the first year.</td></tr></tbody>
        </table>
        <p class="units">Carbon in grams per square metre per year (soil carbon in kilograms per square metre); water in millimetres.</p>
      </div>
    </section>

    <section class="about-model">
      <h2>About this model</h2>
      <p>Patch is a teaching model, not a research tool. It keeps the structure of a dynamic vegetation model and leaves out a lot: nutrients, competition between plant types, fire, grazing and the real daily weather. Its numbers are plausible, not predictions. Real plants usually gain less from extra CO₂ than Patch shows, because nitrogen and other nutrients run short.</p>
      <p>The processes follow the logic of LPJ and LPJmL, described in Sitch et al. (2003, <em>Global Change Biology</em>) and Schaphoff et al. (2018, <em>Geoscientific Model Development</em>). Free to use in teaching and outreach.</p>
    </section>
  </div>
</Base>

<style>
  .crumb { margin: 0 0 0.5rem; font-size: 0.92rem; }
  .layout { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 2rem; align-items: start; }
  .scene-wrap { position: relative; border-radius: 10px; overflow: hidden; border: 1px solid var(--line); }
  #scene { display: block; width: 100%; height: auto; }

  .patch-page {
    --sky: #d6e7ea; --soil: #8b6c4c; --soil-c: #3e2d1f; --water: #6fa6c4;
    --leaf: #4c8a3a; --straw: #c6a35a; --litter: #a5875a; --root: #e8dcc4; --sun: #f2b84b;
    --co2: #4b5d63; --vapour: #2f80b0; --flower: #f4f1e6; --snow: #f4f7f8;
  }
  :global([data-theme='night']) .patch-page {
    --sky: #1b2b33; --soil: #5a4632; --soil-c: #241910; --water: #3f7396;
    --leaf: #7fbf72; --straw: #c9a865; --litter: #7d6847; --root: #cbbd9f; --sun: #f0c06a;
    --co2: #a9b6aa; --vapour: #8cc8ec; --flower: #eef2ea; --snow: #dfe7ea;
  }
  #sky { fill: var(--sky); }
  #sun { fill: var(--sun); }
  #soil { fill: var(--soil); }
  #soilc { fill: var(--soil-c); opacity: 0.75; }
  #water { fill: var(--water); }
  #bucket-line { stroke: var(--water); stroke-width: 2; stroke-dasharray: 6 6; }
  #litter { fill: var(--litter); }
  #snow { fill: var(--snow); }

  .hot {
    position: absolute; transform: translate(-50%, -50%);
    font: inherit; font-size: 0.78rem; font-weight: 500; line-height: 1;
    padding: 0.35rem 0.55rem; border-radius: 3px; cursor: pointer;
    background: color-mix(in srgb, var(--surface) 88%, transparent); color: var(--ink);
    border: 1px solid var(--line);
  }
  .hot:hover, .hot[aria-current='true'] { border-color: var(--blue); color: var(--blue); }
  .clock { position: absolute; left: 0.75rem; top: 0.6rem; margin: 0; display: flex; gap: 0.75rem; font-family: var(--mono); font-size: 0.75rem; color: var(--ink); background: color-mix(in srgb, var(--surface) 80%, transparent); padding: 0.3rem 0.5rem; border-radius: 3px; }

  .transport { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; margin-top: 0.9rem; }
  .speed { display: inline-flex; border: 1px solid var(--line); border-radius: 3px; overflow: hidden; }
  .speed button, .ghost { font: inherit; font-size: 0.9rem; background: none; border: 0; color: var(--ink); padding: 0.5rem 0.85rem; cursor: pointer; }
  .speed button[aria-pressed='true'] { background: var(--blue-soft); color: var(--blue); font-weight: 500; }
  .ghost { border: 1px solid var(--line); border-radius: 3px; }

  .limits { margin-top: 1.5rem; }
  .limits h2, .controls h2, .results h2, .about-model h2 { font-size: 1.25rem; }
  .meters { display: grid; gap: 0.5rem; }
  .meter { display: grid; grid-template-columns: 6.5rem 1fr; align-items: center; gap: 0.75rem; font-size: 0.9rem; }
  .bar { height: 0.6rem; background: var(--line); border-radius: 2px; overflow: hidden; }
  .bar i { display: block; height: 100%; width: 0; background: var(--blue); transition: width 0.25s linear; }
  .verdict { margin: 0.75rem 0 0; }
  .verdict span { color: var(--muted); }

  .controls { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 1.25rem 1.25rem 1.5rem; }
  .ctl { display: grid; gap: 0.35rem; margin-bottom: 1.1rem; }
  .lab { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.95rem; }
  .lab output { font-family: var(--mono); font-size: 0.8rem; color: var(--blue); }
  .ends { display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--muted); }
  input[type='range'] { width: 100%; accent-color: var(--blue); }
  .presets h3 { font-family: var(--sans); font-weight: 500; font-size: 1rem; margin-bottom: 0.5rem; }
  .preset-row { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .preset-row button { font: inherit; font-size: 0.85rem; padding: 0.35rem 0.65rem; border: 1px solid var(--line); background: var(--bg); color: var(--ink); border-radius: 3px; cursor: pointer; }
  .preset-row button:hover, .preset-row button[aria-pressed='true'] { border-color: var(--ochre); color: var(--ochre); }
  .note { font-size: 0.9rem; color: var(--muted); margin: 0.75rem 0 0; min-height: 4.5em; }

  .box { margin-top: 3rem; border-top: 1px solid var(--line); padding-top: 1.5rem; }
  .box-tabs { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; margin-bottom: 1rem; }
  .box-tabs button { font: inherit; background: none; border: 0; border-bottom: 2px solid transparent; padding: 0.3rem 0; color: var(--muted); cursor: pointer; }
  .box-tabs button[aria-selected='true'] { color: var(--ink); border-bottom-color: var(--ochre-fill); }
  .box-body h2 { font-size: 1.5rem; }
  .box-cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem 2rem; }
  .box-cols h3 { font-family: var(--sans); font-weight: 500; font-size: 0.95rem; color: var(--muted); margin-bottom: 0.4rem; }
  .eq { font-family: var(--mono); font-size: 0.78rem; background: var(--surface); border: 1px solid var(--line); padding: 0.6rem 0.75rem; border-radius: 4px; }

  .results { margin-top: 3rem; border-top: 1px solid var(--line); padding-top: 1.5rem; }
  .charts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .charts figure { margin: 0; }
  figcaption { font-size: 0.9rem; margin-bottom: 0.4rem; display: flex; justify-content: space-between; gap: 1rem; }
  .chart { width: 100%; height: auto; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; }
  #c-plant polyline { fill: none; stroke: var(--leaf, #4c8a3a); stroke-width: 2; }
  #c-soil polyline { fill: none; stroke: var(--ochre-fill); stroke-width: 2; }
  .table-wrap { overflow-x: auto; margin-top: 1.5rem; }
  table { border-collapse: collapse; width: 100%; font-size: 0.9rem; font-variant-numeric: tabular-nums; }
  .table-wrap :global(th), .table-wrap :global(td) { text-align: right; padding: 0.45rem 0.6rem; border-bottom: 1px solid var(--line); }
  .table-wrap :global(th:first-child), .table-wrap :global(td:first-child) { text-align: left; }
  th { font-weight: 500; color: var(--muted); }
  .units { font-size: 0.82rem; color: var(--muted); margin-top: 0.5rem; }
  .about-model { margin-top: 3rem; border-top: 1px solid var(--line); padding-top: 1.5rem; }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    .box-cols, .charts { grid-template-columns: 1fr; }
    .hot { font-size: 0.68rem; padding: 0.25rem 0.4rem; }
  }
</style>

<script>
  import { initialState, step, rng, seasonOf, type Settings, type State, type Fluxes } from '../../lib/patch-model';

  const $ = <T extends Element = HTMLElement>(id: string) => document.getElementById(id) as unknown as T;
  const NS = 'http://www.w3.org/2000/svg';
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

  // ---------- settings and controls ----------
  const inputs = {
    temp: $<HTMLInputElement>('i-temp'), rain: $<HTMLInputElement>('i-rain'),
    co2: $<HTMLInputElement>('i-co2'), soil: $<HTMLInputElement>('i-soil'),
  };
  const settings = (): Settings => ({
    tempMean: +inputs.temp.value, rain: +inputs.rain.value, co2: +inputs.co2.value, soilCap: +inputs.soil.value,
  });
  const soilName = (cap: number) => (cap < 90 ? 'Sand' : cap < 130 ? 'Sandy loam' : cap < 180 ? 'Loam' : 'Clay');
  function showSettings() {
    const s = settings();
    $('o-temp').textContent = `${s.tempMean} °C`;
    $('o-rain').textContent = `${s.rain} mm`;
    $('o-co2').textContent = `${s.co2} ppm`;
    $('o-soil').textContent = soilName(s.soilCap);
  }

  let S: Settings = settings();
  let st: State = initialState(S);
  let rand = rng(1);
  let f: Fluxes = step({ ...st }, S, rng(2));
  const history: { plant: number; soil: number }[] = [];
  const years: { year: number; gpp: number; npp: number; transp: number; runoff: number; soilC: number }[] = [];
  let acc = { gpp: 0, npp: 0, transp: 0, runoff: 0 };

  Object.values(inputs).forEach((el) => el.addEventListener('input', () => {
    S = settings(); showSettings(); clearPreset();
  }));

  // ---------- presets ----------
  const PRESETS: Record<string, { s: Partial<Settings>; note: string }> = {
    today: { s: { tempMean: 10, rain: 700, co2: 420, soilCap: 150 }, note: 'A cool temperate grassland under today’s CO₂. Growth stops in winter, peaks in early summer, and is often held back by water in July.' },
    preind: { s: { tempMean: 9, co2: 280 }, note: 'The same place before industry: a little cooler, with a third less CO₂. Plants capture less carbon each year, and the soil slowly loses some of its store.' },
    ice: { s: { tempMean: 2, rain: 450, co2: 180 }, note: 'An Ice Age world: cold, dry and starved of CO₂. The season is short and growth crawls. Farming took off only after the Ice Age ended and CO₂ rose.' },
    double: { s: { co2: 840 }, note: 'Double today’s CO₂. Growth rises, but nowhere near double: light, water and temperature still set limits. In the real world, nutrients cap the gain even more.' },
    drought: { s: { rain: 250 }, note: 'A dry climate. Watch the soil water run out by early summer and the grass turn to straw while it is still warm enough to grow.' },
    hot: { s: { tempMean: 18 }, note: 'Eight degrees warmer. The season is longer, but hot summers dry the soil and plants burn more of their sugar just to stay alive.' },
  };
  const presetBtns = document.querySelectorAll<HTMLButtonElement>('[data-preset]');
  function clearPreset() { presetBtns.forEach((b) => b.setAttribute('aria-pressed', 'false')); }
  presetBtns.forEach((b) => b.addEventListener('click', () => {
    const p = PRESETS[b.dataset.preset!];
    const base = b.dataset.preset === 'today' ? p.s : { ...PRESETS.today.s, ...p.s };
    for (const [k, v] of Object.entries(base)) {
      const el = { tempMean: inputs.temp, rain: inputs.rain, co2: inputs.co2, soilCap: inputs.soil }[k as keyof Settings];
      el.value = String(v);
    }
    S = settings(); showSettings();
    clearPreset(); b.setAttribute('aria-pressed', 'true');
    $('preset-note').textContent = p.note;
    if (!playing) togglePlay();
  }));

  // ---------- scene ----------
  const svg = $<SVGSVGElement>('scene');
  const css = () => getComputedStyle(document.querySelector('.patch-page')!);
  let C = readColours();
  function readColours() {
    const c = css();
    const g = (n: string) => c.getPropertyValue(n).trim();
    return { leaf: g('--leaf'), straw: g('--straw'), root: g('--root'), co2: g('--co2'), vapour: g('--vapour'), flower: g('--flower'), litter: g('--litter'), snow: g('--snow') };
  }
  document.addEventListener('themechange', () => { C = readColours(); drawStars(); });

  function mix(a: string, b: string, t: number) {
    const p = (h: string) => h.startsWith('#') ? [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16)) : [128, 128, 128];
    const [x, y] = [p(a), p(b)];
    return `rgb(${x.map((v, i) => Math.round(v + (y[i] - v) * t)).join(',')})`;
  }

  const GROUND = 262;
  const r0 = rng(99);
  const tufts = Array.from({ length: 26 }, (_, i) => ({
    x: 24 + i * 29.5 + (r0() - 0.5) * 14,
    scale: 0.75 + r0() * 0.5,
    blades: 4 + Math.floor(r0() * 3),
    lean: (r0() - 0.5) * 0.6,
    flower: r0() < 0.35,
  }));
  const plantsG = $('plants'), rootsG = $('roots');
  const tuftEls = tufts.map((t) => {
    const g = document.createElementNS(NS, 'g');
    const blades = Array.from({ length: t.blades }, () => {
      const p = document.createElementNS(NS, 'path');
      p.setAttribute('fill', 'none'); p.setAttribute('stroke-width', '3'); p.setAttribute('stroke-linecap', 'round');
      g.appendChild(p); return p;
    });
    const fl = document.createElementNS(NS, 'circle'); fl.setAttribute('r', '4'); g.appendChild(fl);
    plantsG.appendChild(g);
    const rg = document.createElementNS(NS, 'path');
    rg.setAttribute('fill', 'none'); rg.setAttribute('stroke-width', '1.4'); rg.setAttribute('opacity', '0.8');
    rootsG.appendChild(rg);
    return { blades, fl, rg };
  });

  function drawPlants(growingNow: boolean) {
    const plant = st.leaf + st.stem;
    const h = Math.min(205, 8 + plant * 0.6);
    const stress = growingNow ? 1 - Math.min(1, f.fW * 1.25) : 1;
    const colour = mix(C.leaf, C.straw, stress);
    const rootLen = Math.min(175, 18 + st.root * 0.28);
    const sway = reduce ? 0 : Math.sin(performance.now() / 900);
    const summer = seasonOf(st.day);
    tufts.forEach((t, i) => {
      const el = tuftEls[i];
      el.blades.forEach((b, k) => {
        const spread = (k - (t.blades - 1) / 2) * 7;
        const bh = h * t.scale * (0.75 + 0.25 * Math.cos(k * 1.7));
        const tipX = t.x + spread * 1.8 + (t.lean + sway * 0.08) * bh * 0.5;
        b.setAttribute('d', `M${t.x + spread * 0.3},${GROUND} Q${t.x + spread},${GROUND - bh * 0.55} ${tipX},${GROUND - bh}`);
        b.setAttribute('stroke', colour);
      });
      const show = t.flower && growingNow && summer > 0.35 && f.fW > 0.45 && h > 50;
      el.fl.setAttribute('cx', String(t.x + t.lean * h * t.scale * 0.5));
      el.fl.setAttribute('cy', String(GROUND - h * t.scale - 3));
      el.fl.setAttribute('fill', C.flower);
      el.fl.setAttribute('opacity', show ? '1' : '0');
      const rl = rootLen * t.scale;
      el.rg.setAttribute('d', `M${t.x},${GROUND + 2} q-6,${rl * 0.5} -2,${rl} M${t.x},${GROUND + 2} q10,${rl * 0.35} 14,${rl * 0.7} M${t.x},${GROUND + 2} q-14,${rl * 0.3} -18,${rl * 0.55}`);
      el.rg.setAttribute('stroke', C.root);
    });
  }

  function drawStars() {
    const g = $('stars'); g.innerHTML = '';
    if (document.documentElement.dataset.theme !== 'night') return;
    const r = rng(5);
    for (let i = 0; i < 40; i++) {
      const c = document.createElementNS(NS, 'circle');
      c.setAttribute('cx', String(r() * 800)); c.setAttribute('cy', String(r() * 200));
      c.setAttribute('r', String(0.6 + r())); c.setAttribute('fill', '#e6ece4'); c.setAttribute('opacity', String(0.3 + r() * 0.5));
      g.appendChild(c);
    }
  }
  drawStars();

  // particles: CO2 drawn into leaves, water vapour out, CO2 from microbes, rain or snow
  type P = { el: SVGElement; x: number; y: number; vx: number; vy: number; life: number };
  const pools: Record<string, P[]> = { co2: [], vapour: [], decomp: [], rain: [] };
  function spawn(kind: 'co2' | 'vapour' | 'decomp' | 'rain', snowing = false) {
    if (reduce || pools[kind].length > (kind === 'co2' ? 22 : 45)) return;
    const g = $(kind);
    let el: SVGElement, x = 0, y = 0, vx = 0, vy = 0;
    if (kind === 'rain') {
      el = document.createElementNS(NS, snowing ? 'circle' : 'line');
      x = Math.random() * 800; y = -10; vx = snowing ? (Math.random() - 0.5) * 0.6 : -0.6; vy = snowing ? 1.4 : 7;
      if (snowing) { el.setAttribute('r', '2.2'); el.setAttribute('fill', C.snow); }
      else { el.setAttribute('stroke', C.vapour); el.setAttribute('stroke-width', '1.5'); el.setAttribute('opacity', '0.7'); }
    } else if (kind === 'co2') {
      el = document.createElementNS(NS, 'text');
      el.textContent = 'CO₂'; el.setAttribute('font-size', '11'); el.setAttribute('fill', C.co2); (el as SVGElement).style.fontFamily = 'var(--mono)';
      x = 40 + Math.random() * 720; y = 30 + Math.random() * 60; vx = (Math.random() - 0.5) * 0.4; vy = 0.9 + Math.random() * 0.5;
    } else if (kind === 'vapour') {
      el = document.createElementNS(NS, 'circle'); el.setAttribute('r', '2.5'); el.setAttribute('fill', C.vapour); el.setAttribute('opacity', '0.6');
      const t = tufts[Math.floor(Math.random() * tufts.length)];
      x = t.x; y = GROUND - Math.min(205, 8 + (st.leaf + st.stem) * 0.6) * 0.8; vx = (Math.random() - 0.5) * 0.5; vy = -1.1;
    } else {
      el = document.createElementNS(NS, 'circle'); el.setAttribute('r', '2'); el.setAttribute('fill', C.co2); el.setAttribute('opacity', '0.55');
      x = Math.random() * 800; y = GROUND - 2; vx = (Math.random() - 0.5) * 0.3; vy = -0.7;
    }
    g.appendChild(el);
    pools[kind].push({ el, x, y, vx, vy, life: kind === 'rain' ? 80 : 110 });
  }
  function moveParticles() {
    for (const kind of Object.keys(pools)) {
      const list = pools[kind];
      for (let i = list.length - 1; i >= 0; i--) {
        const p = list[i];
        p.x += p.vx; p.y += p.vy; p.life -= 1;
        const canopyTop = GROUND - Math.min(205, 8 + (st.leaf + st.stem) * 0.6);
        const dead = p.life <= 0 || (kind === 'co2' && p.y > canopyTop + 10) || (kind === 'rain' && p.y > GROUND) || p.y < -10;
        if (dead) { p.el.remove(); list.splice(i, 1); continue; }
        if (p.el.tagName === 'line') { p.el.setAttribute('x1', String(p.x)); p.el.setAttribute('y1', String(p.y)); p.el.setAttribute('x2', String(p.x - 2)); p.el.setAttribute('y2', String(p.y + 12)); }
        else if (p.el.tagName === 'text') { p.el.setAttribute('x', String(p.x)); p.el.setAttribute('y', String(p.y)); p.el.setAttribute('opacity', String(Math.min(1, p.life / 40))); }
        else { p.el.setAttribute('cx', String(p.x)); p.el.setAttribute('cy', String(p.y)); }
      }
    }
  }

  let snowDepth = 0;
  function drawScene() {
    const season = seasonOf(st.day);
    const sun = $('sun');
    sun.setAttribute('cy', String(150 - season * 80));
    sun.setAttribute('r', String(18 + f.light * 1.6));
    const cap = S.soilCap;
    const soilTop = 268, soilH = 192;
    const wFrac = Math.min(1, st.water / cap);
    const bucketH = (cap / 230) * soilH;
    const wH = wFrac * bucketH;
    const w = $('water'); w.setAttribute('y', String(460 - wH)); w.setAttribute('height', String(wH));
    $('bucket-line').setAttribute('y1', String(460 - bucketH)); $('bucket-line').setAttribute('y2', String(460 - bucketH));
    const cH = Math.min(80, (st.soilC / 12000) * 70 + 4);
    $('soilc').setAttribute('height', String(cH)); $('soilc').setAttribute('y', String(soilTop));
    const lH = Math.min(10, 2 + st.litter / 60);
    $('litter').setAttribute('y', String(GROUND - lH + 3)); $('litter').setAttribute('height', String(lH));
    if (f.temp < 0 && f.raining) snowDepth = Math.min(14, snowDepth + 1.5);
    if (f.temp > 0) snowDepth = Math.max(0, snowDepth - 0.6);
    $('snow').setAttribute('y', String(GROUND - snowDepth)); $('snow').setAttribute('height', String(snowDepth));
    drawPlants(f.growing);
    void soilH;
  }

  // ---------- readouts ----------
  const pct = (x: number) => `${Math.round(Math.max(0, Math.min(1, x)) * 100)}%`;
  function readouts() {
    $('t-date').textContent = `Year ${st.year}, ${MONTHS[Math.min(11, Math.floor(st.day / 30.42))]}`;
    $('t-temp').textContent = `${Math.round(f.temp)} °C`;
    ($('m-light') as HTMLElement).style.width = pct(f.light / 13);
    ($('m-water') as HTMLElement).style.width = pct(f.fW);
    ($('m-temp') as HTMLElement).style.width = pct(f.fT);
    const msg: Record<Fluxes['limit'], string> = {
      cold: 'Too cold to grow. The grass is dormant.',
      water: 'Water is the main limit right now.',
      temperature: 'Temperature is the main limit right now.',
      light: 'Light is the main limit right now.',
      none: 'Nothing is holding growth back. Peak conditions.',
    };
    $('v-limit').textContent = msg[f.limit];
    const boost = Math.round((f.fCO2 - 1) * 100);
    $('v-co2').textContent = boost === 0 ? '' : `CO₂ is ${boost > 0 ? 'boosting' : 'cutting'} photosynthesis by ${Math.abs(boost)}% compared with before industry.`;
  }

  function line(id: string, values: number[], min: number, max: number) {
    const pl = document.querySelector(`#${id} polyline`)!;
    if (values.length < 2) { pl.setAttribute('points', ''); return; }
    const n = values.length;
    const pts = values.map((v, i) => `${((i / (n - 1)) * 396 + 2).toFixed(1)},${(116 - ((v - min) / (max - min || 1)) * 108).toFixed(1)}`);
    pl.setAttribute('points', pts.join(' '));
  }
  function charts() {
    const recent = history.slice(-1095);
    const plant = recent.map((h) => h.plant);
    line('c-plant', plant, 0, Math.max(150, ...plant) * 1.05);
    const soil = history.map((h) => h.soil);
    const lo = Math.min(...soil), hi = Math.max(...soil);
    const pad = Math.max(200, (hi - lo) * 0.2);
    line('c-soil', soil.filter((_, i) => i % 5 === 0), lo - pad, hi + pad);
    $('c-plant-v').textContent = `${Math.round(st.leaf + st.stem)} g/m²`;
    $('c-soil-v').textContent = `${(st.soilC / 1000).toFixed(2)} kg/m²`;
  }
  function table() {
    const rows = years.slice(-5).reverse().map((y) => `<tr><td>${y.year}</td><td>${Math.round(y.gpp)}</td><td>${Math.round(y.npp)}</td><td>${Math.round(y.transp)}</td><td>${Math.round(y.runoff)}</td><td>${(y.soilC / 1000).toFixed(2)}</td></tr>`);
    $('years').innerHTML = rows.join('') || '<tr><td colspan="6">Results appear after the first year.</td></tr>';
  }

  // ---------- simulation loop ----------
  let playing = !reduce;
  let daysPerSec = 10;
  let carry = 0, last = performance.now(), sinceChart = 0;

  function simDay() {
    const yearBefore = st.year;
    f = step(st, S, rand);
    acc.gpp += f.gpp; acc.npp += f.npp; acc.transp += f.transp; acc.runoff += f.runoff;
    history.push({ plant: st.leaf + st.stem, soil: st.soilC });
    if (history.length > 365 * 40) history.shift();
    if (st.year !== yearBefore) {
      years.push({ year: yearBefore, ...acc, soilC: st.soilC });
      acc = { gpp: 0, npp: 0, transp: 0, runoff: 0 };
      table();
    }
    // particles proportional to what is flowing today
    if (f.raining) for (let i = 0; i < Math.min(6, 1 + f.rainToday); i++) spawn('rain', f.temp < 0);
    if (Math.random() < f.gpp / 6) spawn('co2');
    if (Math.random() < f.transp / 2.5) spawn('vapour');
    if (Math.random() < f.respSoil / 3) spawn('decomp');
  }

  function frame(now: number) {
    const dt = Math.min(0.1, (now - last) / 1000); last = now;
    if (playing) {
      carry += dt * daysPerSec;
      while (carry >= 1) { simDay(); carry -= 1; sinceChart += 1; }
      if (sinceChart >= 5) { charts(); sinceChart = 0; }
    }
    moveParticles();
    drawScene();
    readouts();
    requestAnimationFrame(frame);
  }

  const playBtn = $<HTMLButtonElement>('play');
  function togglePlay() { playing = !playing; playBtn.textContent = playing ? 'Pause' : 'Play'; }
  playBtn.textContent = playing ? 'Pause' : 'Play';
  playBtn.addEventListener('click', togglePlay);
  document.querySelectorAll<HTMLButtonElement>('[data-speed]').forEach((b) => b.addEventListener('click', () => {
    daysPerSec = +b.dataset.speed!;
    document.querySelectorAll('[data-speed]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
  }));
  $('reset').addEventListener('click', () => {
    S = settings(); st = initialState(S); rand = rng(1);
    history.length = 0; years.length = 0; acc = { gpp: 0, npp: 0, transp: 0, runoff: 0 };
    f = step({ ...st }, S, rng(2)); table(); charts();
  });

  // ---------- open the box ----------
  const BOX: Record<string, { title: string; plain: string; toy: string; eq: string; model: string }> = {
    photosynthesis: {
      title: 'Photosynthesis',
      plain: 'Leaves catch sunlight and use it to turn CO₂ from the air and water from the soil into sugar. More leaves catch more light, but only if it is warm enough, there is water to spare and there is CO₂ to use.',
      toy: 'Patch works out how much light the leaves absorb, multiplies it by a fixed efficiency, then scales it down by whatever is in short supply today: temperature, water or CO₂. The meters under the scene show these factors live.',
      eq: 'carbon captured = efficiency × light absorbed × f(temperature) × f(water) × f(CO₂)',
      model: 'LPJmL calculates photosynthesis from the biochemistry of the leaf (the Farquhar model), separately for different plant types, with light, temperature, CO₂ and the opening of leaf pores all interacting. It runs on a grid covering the whole land surface, every day.',
    },
    water: {
      title: 'Soil water',
      plain: 'Soil works like a bucket. Rain fills it, plants drink from it, the sun dries it, and once it is full the extra water drains away. Sandy soil is a small bucket; clay is a big one.',
      toy: 'The blue layer is the water in the soil and the dashed line is the bucket’s size. Each day plants ask for water depending on heat, light and leaf area, and get what the roots can pull out. If supply falls short, photosynthesis slows and leaves start to brown.',
      eq: 'water stress = min(1, what roots can supply ÷ what leaves demand)',
      model: 'LPJmL splits the soil into several layers with their own water, temperature and even frozen ground. Roots reach different depths for different plants, and water flows down, runs off and evaporates between layers.',
    },
    growth: {
      title: 'Growth',
      plain: 'Plants spend part of their sugar just staying alive, more when it is hot. What is left builds new leaves, roots and stems. Leaves grow in spring, peak in summer and die back in autumn.',
      toy: 'About half of the carbon captured goes to respiration, more on hot days. The rest is split between leaves, roots and stems. Leaves sprout when it gets warmer than 5 °C and are shed faster in cold, drought and extreme heat.',
      eq: 'growth = carbon captured − respiration;  split: 45% leaves, 30% roots, 25% stems',
      model: 'LPJmL tracks many plant types, from grasses to trees and crops, each with its own rules for when to grow, how to divide carbon and how tall to get. Crops are sown and harvested on schedules, and plant types compete for light and water.',
    },
    decomposition: {
      title: 'Decomposition',
      plain: 'Dead leaves and roots become litter. Fungi, bacteria and soil animals break it down, breathing out CO₂ as they go. They work fastest when it is warm and moist, and almost stop when it is cold or dry.',
      toy: 'The tan layer on the surface is litter. Each day a small share decays; the speed doubles with every 10 °C of warming and falls in dry soil. Most of it returns to the air as CO₂; about a third becomes long-lived soil carbon.',
      eq: 'decay rate = base rate × 2^((temperature − 10) ÷ 10) × moisture',
      model: 'LPJmL uses the same idea, with separate pools that decay at different speeds and decomposition that depends on the temperature and moisture of each soil layer.',
    },
    soilcarbon: {
      title: 'Soil carbon',
      plain: 'Soils hold more carbon than all plants and the atmosphere combined. It builds up slowly from dead plant matter and leaks out slowly as microbes eat it. That is why the soil reacts over decades, while plants react within a season.',
      toy: 'The dark band at the top of the soil is its carbon store. It takes about 30 years at 10 °C for half of it to turn over, so after you change the climate, watch the soil chart: plants adjust in a year, the soil keeps drifting for decades. Patch starts by running 300 hidden years so the soil begins in balance, just like the spin-up of a real model.',
      eq: 'change in soil carbon = 0.3 × litter decayed − soil carbon × slow rate × f(temperature, moisture)',
      model: 'Full models spin up for thousands of simulated years before an experiment, so soils start in balance with the climate. LPJmL tracks fast and slow soil pools in each soil layer.',
    },
  };
  const tabs = document.querySelectorAll<HTMLButtonElement>('.box-tabs [data-box]');
  function openBox(key: string, scroll = false) {
    const b = BOX[key];
    $('b-title').textContent = b.title; $('b-plain').textContent = b.plain; $('b-toy').textContent = b.toy;
    $('b-eq').textContent = b.eq; $('b-model').textContent = b.model;
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.box === key)));
    document.querySelectorAll('.hot').forEach((h) => h.setAttribute('aria-current', String((h as HTMLElement).dataset.box === key)));
    if (scroll) document.querySelector('.box')!.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
  }
  tabs.forEach((t) => t.addEventListener('click', () => openBox(t.dataset.box!)));
  document.querySelectorAll<HTMLButtonElement>('.hot').forEach((h) => h.addEventListener('click', () => openBox(h.dataset.box!, true)));
  openBox('photosynthesis');

  showSettings(); table(); charts();
  requestAnimationFrame((t) => { last = t; frame(t); });
</script>
