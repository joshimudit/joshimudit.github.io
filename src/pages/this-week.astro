---
import Base from '../layouts/Base.astro';
import { issues, formatDay, host } from '../data/digest';

const drawings = import.meta.glob('../assets/digest/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const drawing = (name?: string) => (name ? drawings[`../assets/digest/${name}.svg`] : undefined);

const sorted = [...issues].sort((a, b) => b.number - a.number);
const [latest, ...past] = sorted;
const pad = (n: number) => String(n).padStart(2, '0');
// Where "home" is. The tag links to the official tourism site.
const HOME = { name: 'Uttarakhand', url: 'https://www.incredibleindia.gov.in/en/uttarakhand' };
---
<Base title="This Week" description="Five stories a week worth a minute each, from climate and ecosystems to food systems and AI agents.">
  <div class="wrap page">
    <header class="page-head">
      <h1>This Week</h1>
      <p>Five stories worth a minute each, from climate and ecosystems to food systems and AI agents, chosen for what they reveal rather than how loudly they were reported.</p>
    </header>

    {latest ? (
      <article class="issue" aria-labelledby="issue-h">
        <p id="issue-h" class="issue-line data">
          Issue {pad(latest.number)} <span aria-hidden="true">·</span> <time datetime={latest.date}>{formatDay(latest.date)}</time>
        </p>

        <ol class="items">
          {latest.items.map((it, i) => (
            <li class:list={['item', { flip: i % 2 === 1 }]}>
              <div class="body">
                <a class="thumb" href={it.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                  {it.image ? (
                    <img src={it.image} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer"
                      onerror="this.parentElement.classList.add('failed');this.remove()" />
                  ) : drawing(it.illustration) ? (
                    <span class="drawing" set:html={drawing(it.illustration)} />
                  ) : null}
                  <span class="fallback data">{host(it.url)}</span>
                </a>
                {it.image && <p class="credit data">Image via {host(it.url)}</p>}
                {!it.image && drawing(it.illustration) && <p class="credit data">Illustration</p>}
                <div class="text">
                <span class="num" aria-hidden="true">{pad(i + 1)}</span>
                {it.home && (
                  <p class="home data">From home <span aria-hidden="true">·</span> <a href={HOME.url} target="_blank" rel="noopener">{HOME.name}<span class="sr-only"> (Incredible India, opens in a new tab)</span></a></p>
                )}
                <h2>{it.title}</h2>
                <p>{it.summary}</p>
                <p class="why"><span class="label data">In context</span> {it.why}</p>
                {it.take && (
                  <p class="take"><span class="label data">My take</span> {it.take}</p>
                )}
                <p class="src data">
                  <span>{it.source}</span> <span aria-hidden="true">·</span> <time class="nowrap" datetime={it.date}>{formatDay(it.date)}</time> <span aria-hidden="true">·</span>
                  <a class="nowrap" href={it.url} target="_blank" rel="noopener">Read the original<span class="sr-only"> (opens in a new tab)</span> <span aria-hidden="true">↗</span></a>
                </p>
                </div>
              </div>
            </li>
          ))}
        </ol>

        <p class="note">Every item links to its source, and every fact on this page was checked against something I could read. Summaries are in my own words. If it could not be checked, it is not here.</p>
      </article>
    ) : (
      <div class="empty"><p>The first issue is being prepared.</p></div>
    )}

    {past.length > 0 && (
      <section class="archive" aria-labelledby="archive-h">
        <h2 id="archive-h">Past issues</h2>
        {past.map((iss) => (
          <details>
            <summary>
              <span class="data">Issue {pad(iss.number)}</span>
              <time datetime={iss.date}>{formatDay(iss.date)}</time>
            </summary>
            <ol>
              {iss.items.map((it) => (
                <li>
                  {it.home && <span class="home data">From home · {HOME.name}</span>}
                  <a href={it.url} target="_blank" rel="noopener">{it.title}</a>
                  <span class="data"> · {it.source}</span>
                </li>
              ))}
            </ol>
          </details>
        ))}
      </section>
    )}
  </div>
</Base>

<style>
  .issue-line { margin: 0 0 0.5rem; text-transform: uppercase; letter-spacing: 0.08em; }

  .items { list-style: none; padding: 0; margin: 0; }
  .item { padding-block: 2.5rem; border-top: 1px solid var(--line); }
  .item:last-child { border-bottom: 1px solid var(--line); }

  .num {
    display: block;
    font-family: var(--serif);
    font-size: clamp(1.9rem, 3.2vw, 2.5rem);
    line-height: 1;
    color: var(--ochre);
    margin-bottom: 0.6rem;
  }

  /* Rows alternate: text | image, then image | text. */
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    grid-template-areas: 'text thumb' 'text credit' 'text .';
    grid-template-rows: auto auto 1fr;
    column-gap: 3rem;
    align-content: start;
  }
  .flip .body { grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); grid-template-areas: 'thumb text' 'credit text' '. text'; }
  .text { grid-area: text; min-width: 0; }

  /* Image: the source's own preview image, linked to the original. If there is none,
     a small drawing made for that story. If an image fails to load, a quiet tile. */
  .thumb {
    grid-area: thumb;
    display: block;
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 6px;
    margin-top: 0.3rem;
    background: color-mix(in srgb, var(--blue) 7%, var(--bg));
  }
  .thumb, .thumb:hover { text-decoration: none; }
  .thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; }
  .thumb:hover img { transform: scale(1.03); }
  .fallback { display: none; position: absolute; inset: 0; place-items: center; }
  .thumb.failed .fallback { display: grid; }
  .drawing, .drawing :global(svg) { display: block; width: 100%; height: 100%; }
  .drawing :global(.bg) { fill: color-mix(in srgb, var(--blue) 7%, var(--bg)); }
  .drawing :global(.ln), .drawing :global(.crop), .drawing :global(.paper) { fill: none; stroke: var(--blue); stroke-width: 1.4; stroke-linecap: round; }
  .drawing :global(.paper) { fill: var(--bg); stroke-width: 1.6; }
  .drawing :global(.ground) { stroke: color-mix(in srgb, var(--ink) 25%, transparent); stroke-width: 1; }
  .drawing :global(.link) { fill: none; stroke: color-mix(in srgb, var(--blue) 30%, transparent); stroke-width: 1; }
  .drawing :global(.node) { fill: var(--bg); stroke: var(--blue); stroke-width: 1.4; }
  .drawing :global(.coin) { fill: var(--bg); stroke: var(--blue); stroke-width: 1.4; }
  .drawing :global(.acc) { stroke: var(--ochre); fill: color-mix(in srgb, var(--ochre) 18%, var(--bg)); }
  .drawing :global(.lbl) { font-family: var(--mono); font-size: 15px; fill: var(--muted); letter-spacing: 0.03em; }
  .credit { grid-area: credit; margin: 0.45rem 0 0; color: var(--muted); font-size: 0.68rem; }
  @media (prefers-reduced-motion: reduce) { .thumb img { transition: none; } }

  .body p { font-size: 1.02rem; }
  .body .data { font-size: 0.72rem; }
  .body h2 { font-size: clamp(1.3rem, 2vw, 1.6rem); margin-bottom: 0.45em; max-width: 28ch; }
  .body p { max-width: var(--measure); }

  .label {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.15rem;
  }
  .why { color: var(--ink); }
  .take { border-left: 2px solid var(--blue); padding-left: 1rem; font-style: italic; }
  .take .label { font-style: normal; }

  .src { margin: 1.25rem 0 0; line-height: 1.9; }
  .nowrap { white-space: nowrap; }
  .src a { color: var(--blue); }

  /* India items: small mono tag with a diamond marker (shape, not only colour). */
  .home {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.5rem;
    color: var(--ochre);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .home a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .home::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    background: currentColor;
    transform: rotate(45deg);
  }

  .note { margin-top: 2rem; color: var(--muted); font-size: 0.95rem; }

  .archive { margin-top: 4rem; padding-top: 2.5rem; border-top: 1px solid var(--line); }
  .archive h2 { font-size: clamp(1.5rem, 3vw, 2rem); }
  details { border-bottom: 1px solid var(--line); padding-block: 0.9rem; }
  summary { cursor: pointer; display: flex; gap: 1rem; align-items: baseline; }
  details ol { margin: 0.9rem 0 0.4rem; padding-left: 1.25rem; display: grid; gap: 0.5rem; }
  details .home { margin: 0 0.5rem 0 0; }

  @media (max-width: 860px) {
    .body, .flip .body { grid-template-columns: 1fr; grid-template-rows: auto; grid-template-areas: 'thumb' 'credit' 'text'; }
    .credit { margin-bottom: 1.1rem; }
    .item { padding-block: 1.9rem; }
  }
</style>
