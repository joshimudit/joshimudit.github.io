---
import '@fontsource/young-serif';
import '@fontsource-variable/geologica';
import '@fontsource/martian-mono/400.css';
import '../styles/global.css';
import { profile, links } from '../data/profile';
import { icons } from '../data/icons';

interface Props { title?: string; description?: string }
const { title, description = `${profile.name}, ${profile.role.toLowerCase()}. ${profile.lede}` } = Astro.props;
const fullTitle = title ? `${title} | ${profile.name}` : `${profile.name}, ${profile.role.toLowerCase()}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// Structured data on Home: tells search engines and AI tools who this site is about.
const person = path === '/' ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: Astro.site?.toString(),
  image: new URL(profile.photo, Astro.site).toString(),
  email: `mailto:${profile.email}`,
  jobTitle: 'PhD fellow',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Aarhus University', url: 'https://international.au.dk' },
  memberOf: { '@type': 'Organization', name: 'AGRI-DRY, Marie Skłodowska-Curie doctoral network', url: 'https://agri-dry.org' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'ETH Zurich' },
    { '@type': 'CollegeOrUniversity', name: 'Kiel University' },
    { '@type': 'CollegeOrUniversity', name: 'G.B. Pant University of Agriculture and Technology' },
  ],
  knowsAbout: ['Dynamic global vegetation models', 'LPJmL', 'Crop suitability modelling', 'Palaeoclimate', 'Holocene', 'Drylands', 'Food systems', 'Systems thinking', 'Data science'],
  sameAs: links.map((l) => l.href),
}) : null;


const nav = [
  { href: '/work', label: 'Work' },
  { href: '/publications', label: 'Publications' },
  // CV hidden for now; to bring it back, rename src/pages/_cv.astro to cv.astro and restore this line
  // { href: '/cv', label: 'CV' },
  { href: '/this-week', label: 'This Week' },
  { href: '/studio', label: 'Studio' },
  { href: '/blog', label: 'Blog' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(profile.photo, Astro.site)} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    {person && <script type="application/ld+json" set:html={person} />}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var night = saved ? saved === 'night' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = night ? 'night' : 'day';
        } catch (e) { document.documentElement.dataset.theme = 'day'; }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <div class="wrap head-row">
        <a class="home" href="/" aria-current={path === '/' ? 'page' : undefined}>{profile.name}</a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
        <button class="theme" type="button" aria-label="Switch to night theme">
          <svg class="sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"/><g stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></g></svg>
          <svg class="moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-foot">
      <div class="wrap foot-row">
        <p class="sig">© {new Date().getFullYear()} {profile.name}</p>
        <p class="credit">Built with agentic AI and a sceptical human in the loop.</p>
        <ul class="social">
          {[...links.map((l) => ({ ...l, rel: 'me' })), { label: 'Source', href: 'https://github.com/joshimudit/joshimudit.github.io', rel: undefined }].map((l) => (
            <li><a href={l.href} rel={l.rel} aria-label={l.label === 'Source' ? 'Source code of this website' : l.label} title={l.label === 'Source' ? 'Source code of this website' : l.label}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={icons[l.label]} fill="currentColor" /></svg></a></li>
          ))}
        </ul>
      </div>
    </footer>

    <script>
      // Links to other websites open in a new tab; links within the site stay in this tab.
      document.querySelectorAll('a[href]').forEach((a) => {
        const href = a.getAttribute('href') || '';
        if (!/^https?:\/\//i.test(href)) return;
        try {
          if (new URL(href).host === location.host) return;
        } catch { return; }
        a.setAttribute('target', '_blank');
        const rel = new Set((a.getAttribute('rel') || '').split(/\s+/).filter(Boolean));
        rel.add('noopener'); rel.add('noreferrer');
        a.setAttribute('rel', [...rel].join(' '));
      });

      const btn = document.querySelector('.theme') as HTMLButtonElement;
      const sync = () => {
        const night = document.documentElement.dataset.theme === 'night';
        btn.setAttribute('aria-label', night ? 'Switch to day theme' : 'Switch to night theme');
        btn.title = night ? 'Day theme' : 'Night theme';
      };
      sync();
      btn.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'night' ? 'day' : 'night';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
        btn.classList.remove('turn'); void btn.offsetWidth; btn.classList.add('turn');
        sync();
        document.dispatchEvent(new Event('themechange'));
      });
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 0.5rem; background: var(--surface); padding: 0.5rem 1rem; z-index: 10; }
  .skip:focus { left: 0.5rem; }

  .site-head { border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(6px); position: sticky; top: 0; z-index: 5; }
  .head-row { display: flex; align-items: center; gap: 1.5rem; min-height: 4rem; }
  .home { font-family: var(--serif); font-size: 1.25rem; color: var(--ink); text-decoration: none; white-space: nowrap; }
  nav { margin-left: auto; overflow-x: auto; scrollbar-width: none; }
  nav ul { display: flex; gap: 1.25rem; list-style: none; margin: 0; padding: 0; white-space: nowrap; }
  nav a { color: var(--ink); text-decoration: none; font-size: 0.95rem; padding-block: 0.4rem; border-bottom: 2px solid transparent; }
  nav a:hover { border-bottom-color: var(--line); }
  nav a[aria-current='page'] { font-weight: 600; border-bottom-color: var(--ochre); }

  .theme { display: inline-grid; place-items: center; width: 2.4rem; height: 2.4rem; padding: 0; background: none; border: 0; border-radius: 50%; color: var(--ink); cursor: pointer; }
  .theme:hover { background: var(--line); }
  .theme svg { transition: transform 0.5s cubic-bezier(0.3, 0.7, 0.3, 1); }
  .theme:hover svg { transform: rotate(25deg); }
  .theme.turn svg { animation: turn 0.55s cubic-bezier(0.3, 0.7, 0.3, 1); }
  @keyframes turn { from { transform: rotate(-120deg) scale(0.6); opacity: 0.3; } to { transform: rotate(0) scale(1); opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .theme svg, .theme.turn svg { transition: none; animation: none; } }
  :global([data-theme='day']) .moon, :global([data-theme='night']) .sun { display: none; }

  @media (max-width: 760px) {
    .head-row { flex-wrap: wrap; gap: 0.25rem 1rem; padding-block: 0.6rem; }
    nav { order: 3; width: 100%; margin-left: 0; }
    nav ul { flex-wrap: wrap; gap: 0.2rem 1rem; }
    .theme { margin-left: auto; }
  }

  .site-foot { border-top: 1px solid var(--line); padding-block: 2.5rem 3rem; margin-top: 2rem; }
  .foot-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; }
  .foot-row p { margin: 0; }
  .sig { font-family: var(--serif); font-size: 1.05rem; }
  .credit { color: var(--muted); font-size: 0.92rem; }
  .foot-row ul { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; margin: 0 0 0 auto; padding: 0; }
  .social a { display: inline-grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; color: var(--muted); transition: color 0.15s, background-color 0.15s; }
  .social a:hover, .social a:focus-visible { color: var(--blue); background: var(--line); }
  @media (max-width: 760px) { .foot-row ul { margin-left: 0; width: 100%; } }
</style>
